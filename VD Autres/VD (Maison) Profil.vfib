{"name":"Profil","type":"virtual_device","properties":{"deviceIcon":1058,"categories":"[\"other\"]","currentIcon":"1059","log":"","logTemp":"","mainLoop":"--Vérification de l'état du chauffe-eau\nlocal Ballon = fibaro:getValue(558, \"value\")\nlocal Etat \nif Ballon == \"1\"\n  then Etat = \"En marche\"\n  else Etat = \"Arrêt\"\n  end\n  fibaro:debug(\"Etat Chauffe-eau = \" .. Ballon .. \" soit \" .. Etat)\nfibaro:call(657,'setProperty','ui.Label2.value', Etat)\n\n-- vérification des lumières\n-- Liste des interrupteurs de lumières éventuellement \"On\"\nlocal SW1 = fibaro:getValue(599, \"value\")\nSW2 = fibaro:getValue(554, \"value\")\nSW3 = fibaro:getValue(544, \"value\")\n--SW4 = fibaro:getValue(681, \"value\")\nSW4 = fibaro:getValue(596, \"value\")\nSW5 = fibaro:getValue(591, \"value\")\nSW6 = fibaro:getValue(592, \"value\")\nSW7 = fibaro:getValue(595, \"value\")\nSW8 = fibaro:getValue(603, \"value\")\nSW9 = fibaro:getValue(589, \"value\")\n--SW10 =\n\nif  (SW1 == \"1\") or\n    (SW2 == \"1\") or\n    (SW3 == \"1\") or\n    (SW4 == \"1\") or\n    (SW5 == \"1\") or\n    (SW6 == \"1\") or\n    (SW7 == \"1\") or\n    (SW8 == \"1\") or\n    (SW9 == \"1\") -- or (SW10 == \"1\") \n  then \n  \t\tfibaro:debug(\"Il reste encore un swich Fibaro ON\")\n  \t\tfibaro:call(657, 'setProperty', 'ui.Label3.value', \"1 swich ou + ON\")\n   fibaro:debug(\"Liste : \" .. SW1 .. \", \" .. SW2 .. \", \" .. SW3 .. \", \" .. SW4 .. \", \" .. SW5 .. \", \" .. SW6 .. \", \" .. SW7 .. \", \" .. SW8 .. \", \" .. SW9) -- .. \", \" .. SW10 ..\".\")\n\n  else\n  \t\tfibaro:debug(\"Tous les switchs sont OFF\")\n  \t\tfibaro:call(657, 'setProperty', 'ui.Label3.value', \"All Off\")\n   fibaro:debug(\"Liste : \" .. SW1 .. \", \" .. SW2 .. \", \" .. SW3 .. \", \" .. SW4 .. \", \" .. SW5 .. \", \" .. SW6 .. \", \" .. SW7 .. \", \" .. SW8 .. \", \" .. SW9) -- .. \", \" .. SW10 ..\".\")\n\nend\nfibaro:sleep(5000)\n    ","ui.Label1.value":"Présence","ui.Label2.value":"En marche","ui.Label3.value":"All Off","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Profil choisi :","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Présence","name":"Button11","empty":false,"msg":"fibaro:setGlobal(\"Profil\",\"Présence\")\nfibaro:call(657,'setProperty','ui.Label1.value', \"Présence\")\nfibaro:log(\"Sélection du profil Présence\") \n","buttonIcon":1059,"favourite":false,"main":true}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"Abscence","name":"Button21","empty":false,"msg":"fibaro:setGlobal(\"Profil\",\"Abscence\")\nfibaro:call(657,'setProperty','ui.Label1.value', \"Abscence\")\nfibaro:log(\"Sélection du profil Abscence\")","buttonIcon":1060,"favourite":false,"main":false},{"id":4,"lua":true,"waitForResponse":false,"caption":"Vacances","name":"Button22","empty":false,"msg":"fibaro:setGlobal(\"Profil\",\"Vacances\")\nfibaro:call(657,'setProperty','ui.Label1.value', \"Vacances\")\nfibaro:log(\"Sélection du profil Vacances\")","buttonIcon":1056,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":5,"lua":false,"waitForResponse":false,"caption":"Chauffe-eau : ","name":"Label2","favourite":false,"main":false}]},{"type":"label","elements":[{"id":6,"lua":false,"waitForResponse":false,"caption":"Lumières : ","name":"Label3","favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}