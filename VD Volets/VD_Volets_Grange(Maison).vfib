{"name":"VD Volets Grange","type":"virtual_device","properties":{"deviceIcon":1041,"categories":"[\"blinds\"]","currentIcon":"1040","log":"","logTemp":"","mainLoop":"--[[\n%% propertie\n%% events\ncommande\n%% global\n--]]\n\n--Global Variable 'commande' : 0 = Stop, 1= UP, 2 = DOWN\n\nlocal Status_S1 = fibaro.getValue(483,\"value\")\nlocal Status_S2 = fibaro.getValue(485,\"value\")\nfibaro:debug('Position commande S1 ' .. Status-S1)\nfibaro:debug('Position commande S2 ' .. Status-S2)\n\nfibaro:debug('------------- Début du scénario ---------------')\n\nif(tonumber(commande) == 0) \n  then \nfibaro:call(483,\"turnOn\")\nfibaro:call(485,\"turn0n\")\n  \nfibaro:debug('Position commandes ' .. Status_S1 ..\", \" .. Status_S2)\nfibaro:sleep(1500)\nfibaro:debug('Position commandes ' .. Status_S1 ..\", \" .. Status_S2)\n--  elseif (tonumber(commande) == 1)\n-- \tthen\n\t--fibaro:debug('Position commande ' .. Status-S1)\n--\tfibaro:call(483,\"turnOn\")\n\t\n--  \tfibaro:debug('Position commandes ' .. Status_S1 ..\", \" .. Status_S2)\n--\tfibaro:sleep(1500)\n--\tfibaro:debug('Position commandes ' .. Status_S1 ..\", \" .. Status_S2)\n--  \t\telseif (tonumber(commande) == 2)\n--\t\tthen \n--  \t\tfibaro:debug('Position commande ' .. Status-S1)\n--\t\tfibaro:call(485,\"turn0n\")\n--  \t\t\n--\t\tfibaro:debug('Position commandes ' .. Status_S1 ..\", \" .. Status_S2)\n--\t\tfibaro:sleep(1500)\n--\t\tfibaro:debug('Position commandes ' .. Status_S1 .. Status_S2)\n--\t\tend\n--\tend\nend\nfibaro:debug('----------fin du scénario----------')\nfibaro.abort()\n  ","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":true,"waitForResponse":false,"caption":" ▲ OUVRIR","name":"Button11","empty":false,"msg":"-- FGS 483 ID 141 \"ON\" pour 1s\nfibaro:setGlobal('commande', '1')","buttonIcon":1038,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":" 🔄 ARRÊT","name":"Button21","empty":false,"msg":"-- FGS 222 ID 483 et 485 sur \"ON\" pour 1s\nfibaro:setGlobal('commande', '0')","buttonIcon":1040,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"▼ FERMER","name":"Button31","empty":false,"msg":"-- FGS 222 ID 485 \"ON\" pour 1s\nfibaro:setGlobal('commande', '2')","buttonIcon":1039,"favourite":false,"main":true}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}