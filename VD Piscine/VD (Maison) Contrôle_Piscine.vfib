{"name":"Contrôle Piscine","type":"virtual_device","properties":{"deviceIcon":1068,"categories":"[\"remotes\"]","currentIcon":"1068","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% globals\npiscine\n--]]\n-- démarrage de la boucle\nlocal VDID = fibaro:getSelfId()\nlocal pompe = 563 -- devra être changé pour un FGS-222\nlocal gestion = fibaro:getGlobal(\"piscine\")\n--fibaro:debug(\"Mode actuel du VD : \".. gestion)\n--Mise à jour des libellés\nfibaro:call(VDID,'setProperty','ui.Label1.value', gestion)\nfibaro:call(VDID,'setProperty','ui.Label2.value', fibaro:getGlobal(\"hStart\") .. \":00 h\")\nfibaro:call(VDID,'setProperty','ui.Label3.value',fibaro:getGlobal(\"Mduree\") ..\"mn\")\nfibaro:call(VDID,'setProperty','ui.Label4.value',fibaro:getGlobal(\"Hinterval\") ..\"h\")\n\n-- affichage des Paramètres de la scène\nfibaro:debug(\"La gestion du moteur de la piscine est en mode \" .. gestion)\nfibaro:debug(\"Heure de début à \".. fibaro:getGlobal(\"hStart\") .. \":00 h\")\nfibaro:debug(\"Temps de pompage de \" .. fibaro:getGlobal(\"Mduree\") ..\"mn\")\nfibaro:debug(\"Interval entre 2 pompage de \" .. fibaro:getGlobal(\"Hinterval\") .. \"h\")\n----------------------------- TEST ---------------------\n--Hinterval = 1/60 -- ligne à activer tour tester le cycle automatique\n--Penser à modifier le VD pour une valeur hInteral de 1/60h et Mudree pour unr valeur de 1mm\n--fibaro:setGlobal(\"Mduree\",1/60) -- ligne à activer tour tester le cycle automatique\n--------------------------------------------------------\n--fibaro:sleep(1000)\n--fibaro:startScene(24)\nfibaro:debug(\"la scène 24 de gestion du moteur de la piscine a été lancé\")\nlocal tempo = fibaro:getGlobal(\"Mduree\")*60*1000 \nfibaro:debug(\"Attente pour la durée du temps de pompage : \".. fibaro:getGlobal(\"Mduree\") .. \"mn\")\nfibaro:debug(\"Attente pour la durée du temps de pompage : \".. tempo .. \"ms\")\nfibaro:sleep(tempo)\nfibaro:debug(\"Fin de la tempo MOTEUR.\")\n   -- fibaro:call(pompe, \"turnOff\")\nfibaro:debug(\"Etat du moteur : \" .. fibaro:getValue(pompe,\"value\"))\nlocal tempo1 = fibaro:getGlobal(\"Hinterval\")*60*60*1000\nfibaro:debug(\"Attente pour la durée d'interval : \".. fibaro:getGlobal(\"Hinterval\") .. \"h\")\nfibaro:debug(\"Attente pour la durée d'interval : \".. tempo1 .. \"ms\")\nfibaro:sleep(tempo1)\nfibaro:debug(\"Fin de la tempo Interval et redémarrage de la scène 24.\")\nfibaro:startScene(24)\nfibaro:debug(\"----------------------Fin de boucle-------------------\")\n","ui.Label1.value":"Auto","ui.Label2.value":"20:00 h","ui.Label3.value":"10mn","ui.Label4.value":"3h","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Mode : ","name":"Label1","favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Automatique","name":"Button11","empty":false,"msg":"fibaro:killScenes(24)\nfibaro:setGlobal(\"piscine\",\"Auto\")\nfibaro:log(\"Mode Auto\")\n\nVDID = 654\n--fibaro:sleep(500)\nfibaro:call(VDID,'setProperty','ui.Label1.value', \"Auto\")\nfibaro:call(VDID,'setProperty','ui.Label2.value', fibaro:getGlobal(\"hStart\") .. \":00 h\")\nfibaro:call(VDID,'setProperty','ui.Label3.value',fibaro:getGlobal(\"Mduree\") ..\"mn\")\nfibaro:call(VDID,'setProperty','ui.Label4.value',fibaro:getGlobal(\"Hinterval\") ..\"h\")\n\nfibaro:startScene(24)\n\n","buttonIcon":1071,"favourite":false,"main":true}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"Marche forcée","name":"Button21","empty":false,"msg":"fibaro:killScenes(24)\nfibaro:setGlobal(\"piscine\",\"Marche\")\nfibaro:log(\"Mode Marche forcée\")\n\nVDID = 654\n--fibaro:sleep(500)\nfibaro:call(VDID,'setProperty','ui.Label1.value', \"Marche\")\nfibaro:call(VDID,'setProperty','ui.Label2.value', fibaro:getGlobal(\"hStart\") .. \":00 h\")\nfibaro:call(VDID,'setProperty','ui.Label3.value',fibaro:getGlobal(\"Mduree\") ..\"mn\")\nfibaro:call(VDID,'setProperty','