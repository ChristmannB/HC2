{"name":"Heating Override","type":"virtual_device","properties":{"deviceIcon":0,"currentIcon":"0","log":"","logTemp":"","mainLoop":"-- Virtual Device : Heating Override\n-- Version        : 1.3\n-- Date Created   : 19-Nov-2016\n-- Last Changed   : 25-Feb-2017\n-- HC Version     : Home Center 2 v4.110\n-- Created By     : Dave Harrison\n\n-- Revision History\n-- ----------------\n\n-- 1.1 01-Jan-17\tAdd retrieval of current temperature\n-- 1.2 22-Jan-17  Handle situation where VD has not been assigned to a room\n-- 1.3 25-Feb-17\tDay/Week Up/Down buttons\n\n--=============================================\n-- MainLoop\n--=============================================\n\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal newMode = \"\"\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal panelTemp = 0\nlocal panelEndTimestamp = 0\nlocal panelRooms = {}\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal currentTemps = \"\"\nlocal tempUnit = \"\"\nlocal currentTimestamp = os.time()\nlocal delaySeconds = 60\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getDefaultZone\n-----------------\n-- Return the Heating Panel Name and Id that is used\n-- to control the heating for the selected room\n\nfunction getDefaultZone(roomId)\n\n\t-- Get the Heating Panels\n\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating\")\n\t\n\tif (status == \"200\") then\n\t\tlocal panels = json.decode(response)\n\t\t\n\t\t-- For each panel/zone, get the panel details, and check if the selected room is\n\t\t-- controlled by the heating panel. If so, then return the details.\n\t\tfor panelKey, panelValue in pairs(panels) do\n\t\t\t\n\t\t\tresponse ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelValue.id)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local panel = json.decode(response)\n\t\t\t\t\n\t\t\t  local rooms = panel.properties.rooms\n\t\t\t  \n\t\t\t  -- Check to see if the current room is one of the values controlled\n\t\t\t  -- by this heating panel\n\t\t\t  for roomKey, roomValue in pairs(rooms) do\n\t\t\t    if (roomValue == roomId) then\n\t\t\t      return panel.name, panel.id\n\t\t\t    end\n\t\t\t  end\n\t\t\tend\n\t\tend\n\t\t\n\t\t-- Not found, so return the first panel\n\t\treturn panels[1].name, panels[1].id\n\tend\n\t\n\t-- Unable to retrieve the Heating Panel\n\treturn \"Heating Panel Not Found\", 0\nend\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\n\tlocal zoneName = \"\"\n\tlocal zoneId = 0\n\t\n\t-- The zone contains the Panel Name and Id in parentheses\n\tif (zone ~= nil and zone ~= \"\") then\n\t\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\t\n\t\tzoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\t\tzoneId = string.sub(zone, start + 1, finish - 1)\n\tend\n\n\treturn zoneName, zoneId\nend\n\n-- getPanelDetails\n------------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n-- As well as the override temperature and manual End Time\n\nfunction getPanelDetails(panelId)\n\n\tlocal mode = \"\"\n\tlocal temp = 0\n\tlocal timestamp = 0\n\tlocal endTimestamp = 0\n\tlocal rooms = {}\n\t\n\tlocal currentDay = os.date(\"%A\"):lower()  -- monday, tuesday etc\n\tlocal currentMinutes = os.date(\"%H\") * 60 + os.date(\"%M\")\n\tlocal periods = {\"morning\", \"day\", \"evening\", \"night\"}\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response, status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t  \n\t\t  rooms = panel.properties.rooms\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\t\ttemp = panel.properties.vacationTemperature\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\t\ttemp = panel.properties.handTemperature\n\t\t\t\t\tendTimestamp = panel.properties.handTimestamp\n\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t-- Otherwise we're in Auto mode\n\t\t\t\t\t-- We'll need to get the temperature and end time from the schedule\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\t\tlocal endDateTime = os.date(\"*t\")\n\t\t\t\t\tlocal scheduleToday = panel.properties[currentDay]\n\t\t\t\t\t\n\t\t\t\t\t-- If the night starts after midnight, then add on 24 hours\n\t\t\t\t\tif (scheduleToday.night.hour < scheduleToday.evening.hour) then\n\t\t\t\t\t\tscheduleToday.night.hour = scheduleToday.night.hour + 24\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- If we're before the morning period, then get the previous day's night\n\t\t\t\t\tif (currentMinutes < scheduleToday.morning.hour * 60 + scheduleToday.morning.minute) then\n\n\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal yesterday = os.date(\"%A\", os.time() - 24*60*60):lower()\n\t\t\t\t\t\tscheduleToday = panel.properties[yesterday]\n\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\n\t\t\t\t\telse\n\t\t\t\t\t\t\n\t\t\t\t\t\t-- If we're after then night period, then return that\n\t\t\t\t\t\tif (currentMinutes >= scheduleToday.night.hour * 60 + scheduleToday.night.minute) then \n\t\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- The End Time is tomorrow's morning time\n\t\t\t\t\t\t\tlocal tomorrow = os.date(\"%A\", currentTimestamp + 24*60*60):lower()\n\t\t\t\t\t\t\tscheduleToday = panel.properties[tomorrow]\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- Set the date to tomorrow's date\n\t\t\t\t\t\t\tlocal tomorrowDateTime = os.date(\"*t\", currentTimestamp+24*60*60)\n\t\t\t\t\t\t\tendDateTime.day = tomorrowDateTime.day\n\t\t\t\t\t\t\tendDateTime.month = tomorrowDateTime.month\n\t\t\t\t\t\t\tendDateTime.year = tomorrowDateTime.year\n\n\t\t\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t\t\t-- Otherwise find out which period of the day we're in\n\t\t\t\t\t\t\t-- and return the temperature for that period\n\t\t\t\t\t\t\tfor i, value in ipairs(periods) do\n\t\t\t\t\t\t\t\tif (currentMinutes < scheduleToday[value].hour * 60 + scheduleToday[value].minute) then\n\t\t\t\t\t\t\t\t\ttemp = scheduleToday[periods[i - 1]].temperature\n\n\t\t\t\t\t\t\t\t\tendDateTime.hour = scheduleToday[periods[i]].hour\n\t\t\t\t\t\t\t\t\tendDateTime.min = scheduleToday[periods[i]].minute\n\t\t\t\t\t\t\t\t\tendDateTime.sec = 0\n\n\t\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- Convert the Date/Time to a timestamp for Auto mode\n\t\t\t\t\tendTimestamp = os.time(endDateTime)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode, temp, endTimestamp, rooms\nend\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. tempUnit\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- getRoomTemperatures\n----------------------\n-- Get the temperatures of the rooms that the current zone has been assigned to\n\nfunction getRoomTemperatures(rooms)\n\t\n\tlocal roomTemps = \"\"\n\t\n\t\t-- For each room, get the default temperature sensor\n\t\tfor roomKey, roomValue in pairs(rooms) do\n\t\t\t\n\t\t\tlocal response ,status, errorCode = HC2:GET(\"/api/rooms/\" .. roomValue)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local room = json.decode(response)\n\t\t\t\t\n\t\t\t\tif (room ~= nil) then\n\t\t\t  \tlocal tempSensorId = room.defaultSensors.temperature\n\t\t\t  \t\n\t\t\t  \t-- Get the current value of the room's temperature sensor\n\t\t\t  \tif (tempSensorId ~= nil) then\n\t\t\t  \t\tresponse ,status, errorCode = HC2:GET(\"/api/devices/\" .. tempSensorId)\n\t\t\t  \t\tif (status == \"200\") then\n\t\t\t  \t\t\tlocal tempSensor = json.decode(response)\n\t\t\t  \t\t\t\n\t\t\t  \t\t\tif (tempSensor ~= nil) then\n\t\t\t  \t\t\t\tlocal temperature = tempSensor.properties.value\n\t\t\t  \t\t\t\t\n\t\t\t  \t\t\t\t-- Add the temperature to the return string\n\t\t\t  \t\t\t\tif (temperature ~= nil) then\n\t\t\t  \t\t\t\t\t-- First space is a non-breaking space (0xA0)\n\t\t\t  \t\t\t\t\troomTemps = roomTemps .. room.name .. \" \" .. temperature .. tempUnit .. \" \"\n\t\t\t  \t\t\t\tend\n\t\t\t  \t\t\tend\n\t\t\t  \t\tend\n\t\t\t  \tend\n\t\t\t  end\n\t\t\tend\n\t\tend\n\t\n\treturn roomTemps\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Have a mode and zone already been selected?\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- If no current zone, then default it based on the room that the\n-- virtual device is located in\nif (currentZone == \"\" or currentZone == nil) then \n\t-- Get the Current Room\n\tlocal currentRoom = fibaro:getRoomID(selfId)\n\n\tcurrentPanelName, currentPanelId = getDefaultZone(currentRoom)\n\t\n\tif (currentPanelId ~= 0) then\n\t\tcurrentZone = currentPanelName .. \" (\" ..currentPanelId .. \")\"\n\tend\nend\n\n-- Get the current values from the Temp/Time label which may have been overridden\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\ntempUnit = getTemperatureUnit()\n\n-- Get the current values from the Heating Panel\nnewMode, panelTemp, panelEndTimestamp, panelRooms = getPanelDetails(currentPanelId)\n\n-- If the temperature or time has been overridden, then don't update the label\n-- with the current panel information\nif (not overridenTempOrTime) then\n\tlabelTemp = panelTemp\n\tlabelEndTimestamp = panelEndTimestamp\nend\n\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\n-- If the mode has been overridden, then don't overwrite it with the actual mode\nif (currentMode:sub(1,1) ~= \"*\") then\n\tcurrentMode = newMode\nend\n\n-- Get the current temperature of the rooms controlled by this zone\ncurrentTemps = getRoomTemperatures(panelRooms)\n\n-- Set Labels and Sliders\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", currentMode)\nfibaro:call(selfId, \"setProperty\", \"ui.zoneLabel.value\", currentZone)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.currentTempLabel.value\", currentTemps)\n\n-- Sleep for a few seconds so that the main loop doesn't run too often\nfibaro:sleep(delaySeconds * 1000)\n","ui.currentTempLabel.value":"Office 21.00°C ","ui.modeLabel.value":"Auto","ui.tempTimeLabel.value":"10°C for 2h 25m until 00:00","ui.zoneLabel.value":"Office Heating (5)","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":true,"waitForResponse":false,"caption":"Zone ▲","name":"zoneUpButton","empty":false,"msg":"--=============================================\n-- zoneUpButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal previousZone = \"\"\nlocal previousPanelName = \"\"\nlocal previousPanelId = 0\nlocal panelOverrideTemp = 0\nlocal panelEndTimestamp = 0\nlocal panelRooms = {}\nlocal currentTemps = \"\"\nlocal tempTimeLabel = \"\"\nlocal tempUnit = \"\"\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getDefaultZone\n-----------------\n-- Return the Heating Panel Name and Id that is used\n-- to control the heating for the selected room\n\nfunction getDefaultZone(roomId)\n\n\t-- Get the Heating Panels\n\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating\")\n\t\n\tif (status == \"200\") then\n\t\tlocal panels = json.decode(response)\n\t\t\n\t\t-- For each panel/zone, get the panel details, and check if the selected room is\n\t\t-- controlled by the heating panel. If so, then return the details.\n\t\tfor panelKey, panelValue in pairs(panels) do\n\t\t\t\n\t\t\tresponse ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelValue.id)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local panel = json.decode(response)\n\t\t\t\t\n\t\t\t  local rooms = panel.properties.rooms\n\t\t\t  \n\t\t\t  -- Check to see if the current room is one of the values controlled\n\t\t\t  -- by this heating panel\n\t\t\t  for roomKey, roomValue in pairs(rooms) do\n\t\t\t    if (roomValue == roomId) then\n\t\t\t      return panel.name, panel.id\n\t\t\t    end\n\t\t\t  end\n\t\t\tend\n\t\tend\n\tend\n\t\n\t-- The room isn't controlled by a Heating Panel\n\treturn \"Not Found\", 0\nend\n\n-- getPreviousZone\n------------------\n-- Return the Heating Panel Name and Id that is before\n-- the current Heating Panel.  If at the first Heating \n-- Panel, then return the last\n\nfunction getPreviousZone(currentPanelId)\n\n\t-- Get the Heating Panels\n\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating\")\n\t\n\tif (status == \"200\") then\n\t\tlocal panels = json.decode(response)\n\t\t\n\t\t-- Find the current Panel Id in the table\n\t\tfor panelKey, panelValue in pairs(panels) do\n\t\t\tif (tonumber(panelValue.id) == tonumber(currentPanelId)) then\n\t\t\t\t-- If the first entry, then get the last\n\t\t\t\tif (panelKey == 1) then\n\t\t\t\t\tpanelKey = #panels\n\t\t\t\telse\n\t\t\t\t\tpanelKey = panelKey - 1\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\treturn panels[panelKey].name, panels[panelKey].id\n\t\t\tend\n\t\tend\n\tend\n\t\n\t-- Current Panel Id not found, so return the default zone\n\treturn getDefaultZone(fibaro:getRoomID(selfId))\nend\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n-- getPanelDetails\n------------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n-- As well as the override temperature and manual End Time\n\nfunction getPanelDetails(panelId)\n\n\tlocal mode = \"\"\n\tlocal temp = 0\n\tlocal timestamp = 0\n\tlocal endTimestamp = 0\n\tlocal rooms = {}\n\t\n\tlocal currentDay = os.date(\"%A\"):lower()  -- monday, tuesday etc\n\tlocal currentMinutes = os.date(\"%H\") * 60 + os.date(\"%M\")\n\tlocal periods = {\"morning\", \"day\", \"evening\", \"night\"}\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response, status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t  \n\t\t  rooms = panel.properties.rooms\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\t\ttemp = panel.properties.vacationTemperature\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\t\ttemp = panel.properties.handTemperature\n\t\t\t\t\tendTimestamp = panel.properties.handTimestamp\n\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t-- Otherwise we're in Auto mode\n\t\t\t\t\t-- We'll need to get the temperature and end time from the schedule\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\t\tlocal endDateTime = os.date(\"*t\")\n\t\t\t\t\tlocal scheduleToday = panel.properties[currentDay]\n\t\t\t\t\t\n\t\t\t\t\t-- If the night starts after midnight, then add on 24 hours\n\t\t\t\t\tif (scheduleToday.night.hour < scheduleToday.evening.hour) then\n\t\t\t\t\t\tscheduleToday.night.hour = scheduleToday.night.hour + 24\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- If we're before the morning period, then get the previous day's night\n\t\t\t\t\tif (currentMinutes < scheduleToday.morning.hour * 60 + scheduleToday.morning.minute) then\n\n\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal yesterday = os.date(\"%A\", os.time() - 24*60*60):lower()\n\t\t\t\t\t\tscheduleToday = panel.properties[yesterday]\n\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\n\t\t\t\t\telse\n\t\t\t\t\t\t\n\t\t\t\t\t\t-- If we're after then night period, then return that\n\t\t\t\t\t\tif (currentMinutes >= scheduleToday.night.hour * 60 + scheduleToday.night.minute) then \n\t\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- The End Time is tomorrow's morning time\n\t\t\t\t\t\t\tlocal tomorrow = os.date(\"%A\", currentTimestamp + 24*60*60):lower()\n\t\t\t\t\t\t\tscheduleToday = panel.properties[tomorrow]\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- Set the date to tomorrow's date\n\t\t\t\t\t\t\tlocal tomorrowDateTime = os.date(\"*t\", currentTimestamp+24*60*60)\n\t\t\t\t\t\t\tendDateTime.day = tomorrowDateTime.day\n\t\t\t\t\t\t\tendDateTime.month = tomorrowDateTime.month\n\t\t\t\t\t\t\tendDateTime.year = tomorrowDateTime.year\n\n\t\t\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t\t\t-- Otherwise find out which period of the day we're in\n\t\t\t\t\t\t\t-- and return the temperature for that period\n\t\t\t\t\t\t\tfor i, value in ipairs(periods) do\n\t\t\t\t\t\t\t\tif (currentMinutes < scheduleToday[value].hour * 60 + scheduleToday[value].minute) then\n\t\t\t\t\t\t\t\t\ttemp = scheduleToday[periods[i - 1]].temperature\n\n\t\t\t\t\t\t\t\t\tendDateTime.hour = scheduleToday[periods[i]].hour\n\t\t\t\t\t\t\t\t\tendDateTime.min = scheduleToday[periods[i]].minute\n\t\t\t\t\t\t\t\t\tendDateTime.sec = 0\n\n\t\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- Convert the Date/Time to a timestamp for Auto mode\n\t\t\t\t\tendTimestamp = os.time(endDateTime)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode, temp, endTimestamp, rooms\nend\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. tempUnit\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- getRoomTemperatures\n----------------------\n-- Get the temperatures of the rooms that the current zone has been assigned to\n\nfunction getRoomTemperatures(rooms)\n\t\n\tlocal roomTemps = \"\"\n\t\n\t\t-- For each room, get the default temperature sensor\n\t\tfor roomKey, roomValue in pairs(rooms) do\n\t\t\t\n\t\t\tlocal response ,status, errorCode = HC2:GET(\"/api/rooms/\" .. roomValue)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local room = json.decode(response)\n\t\t\t\t\n\t\t\t\tif (room ~= nil) then\n\t\t\t  \tlocal tempSensorId = room.defaultSensors.temperature\n\t\t\t  \t\n\t\t\t  \t-- Get the current value of the room's temperature sensor\n\t\t\t  \tif (tempSensorId ~= nil) then\n\t\t\t  \t\tresponse ,status, errorCode = HC2:GET(\"/api/devices/\" .. tempSensorId)\n\t\t\t  \t\tif (status == \"200\") then\n\t\t\t  \t\t\tlocal tempSensor = json.decode(response)\n\t\t\t  \t\t\t\n\t\t\t  \t\t\tif (tempSensor ~= nil) then\n\t\t\t  \t\t\t\tlocal temperature = tempSensor.properties.value\n\t\t\t  \t\t\t\t\n\t\t\t  \t\t\t\t-- Add the temperature to the return string\n\t\t\t  \t\t\t\tif (temperature ~= nil) then\n\t\t\t  \t\t\t\t\t-- First space is a non-breaking space (0xA0)\n\t\t\t  \t\t\t\t\troomTemps = roomTemps .. room.name .. \" \" .. temperature .. tempUnit .. \" \"\n\t\t\t  \t\t\t\tend\n\t\t\t  \t\t\tend\n\t\t\t  \t\tend\n\t\t\t  \tend\n\t\t\t  end\n\t\t\tend\n\t\tend\n\t\n\treturn roomTemps\nend\n\n--=============================================\n-- Main\n--=============================================\n-- Get the current zone\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the previous Zone\npreviousPanelName, previousPanelId = getPreviousZone(currentPanelId)\npreviousZone = previousPanelName .. \" (\" ..previousPanelId .. \")\"\n\ntempUnit = getTemperatureUnit()\n\n-- Determine if the panel is currently under manual or vacation control\n-- and fetch the Override Temperature and Timestamp\ncurrentMode, panelOverrideTemp, panelEndTimestamp, panelRooms = getPanelDetails(previousPanelId)\n\ntempTimeLabel = formatTempTime(false, panelOverrideTemp, panelEndTimestamp)\n\n-- Get the current temperature of the rooms controlled by this zone\ncurrentTemps = getRoomTemperatures(panelRooms)\n\n-- Set Labels and Sliders\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", currentMode)\nfibaro:call(selfId, \"setProperty\", \"ui.zoneLabel.value\", previousZone)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.currentTempLabel.value\", currentTemps)\n","buttonIcon":0,"favourite":false,"main":true},{"id":2,"lua":true,"waitForResponse":false,"caption":"Zone ▼","name":"zoneDownButton","empty":false,"msg":"--=============================================\n-- zoneDownButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal nextZone = \"\"\nlocal nextPanelName = \"\"\nlocal nextPanelId = 0\nlocal panelOverrideTemp = 0\nlocal panelEndTimestamp = 0\nlocal panelRooms = {}\nlocal currentTemps = \"\"\nlocal tempTimeLabel = \"\"\nlocal tempUnit = \"\"\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getDefaultZone\n-----------------\n-- Return the Heating Panel Name and Id that is used\n-- to control the heating for the selected room\n\nfunction getDefaultZone(roomId)\n\n\t-- Get the Heating Panels\n\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating\")\n\t\n\tif (status == \"200\") then\n\t\tlocal panels = json.decode(response)\n\t\t\n\t\t-- For each panel/zone, get the panel details, and check if the selected room is\n\t\t-- controlled by the heating panel. If so, then return the details.\n\t\tfor panelKey, panelValue in pairs(panels) do\n\t\t\t\n\t\t\tresponse ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelValue.id)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local panel = json.decode(response)\n\t\t\t\t\n\t\t\t  local rooms = panel.properties.rooms\n\t\t\t  \n\t\t\t  -- Check to see if the current room is one of the values controlled\n\t\t\t  -- by this heating panel\n\t\t\t  for roomKey, roomValue in pairs(rooms) do\n\t\t\t    if (roomValue == roomId) then\n\t\t\t      return panel.name, panel.id\n\t\t\t    end\n\t\t\t  end\n\t\t\tend\n\t\tend\n\tend\n\t\n\t-- The room isn't controlled by a Heating Panel\n\treturn \"Not Found\", 0\nend\n\n-- getNextZone\n--------------\n-- Return the Heating Panel Name and Id that is after\n-- the current Heating Panel.  If at the last Heating \n-- Panel, then return the first\n\nfunction getNextZone(currentPanelId)\n\n\t-- Get the Heating Panels\n\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating\")\n\t\n\tif (status == \"200\") then\n\t\tlocal panels = json.decode(response)\n\t\t\n\t\t-- Find the current Panel Id in the table\n\t\tfor panelKey, panelValue in pairs(panels) do\n\t\t\tif (tonumber(panelValue.id) == tonumber(currentPanelId)) then\n\t\t\t\t-- If the last entry, then get the first\n\t\t\t\tif (panelKey == #panels) then\n\t\t\t\t\tpanelKey = 1\n\t\t\t\telse\n\t\t\t\t\tpanelKey = panelKey + 1\n\t\t\t\tend\n\t\t\t\t\n\t\t\t\treturn panels[panelKey].name, panels[panelKey].id\n\t\t\tend\n\t\tend\n\tend\n\t\n\t-- Current Panel Id not found, so return the default zone\n\treturn getDefaultZone(fibaro:getRoomID(selfId))\nend\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n-- getPanelDetails\n------------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n-- As well as the override temperature and manual End Time\n\nfunction getPanelDetails(panelId)\n\n\tlocal mode = \"\"\n\tlocal temp = 0\n\tlocal timestamp = 0\n\tlocal endTimestamp = 0\n\tlocal rooms = {}\n\t\n\tlocal currentDay = os.date(\"%A\"):lower()  -- monday, tuesday etc\n\tlocal currentMinutes = os.date(\"%H\") * 60 + os.date(\"%M\")\n\tlocal periods = {\"morning\", \"day\", \"evening\", \"night\"}\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response, status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t  \n\t\t  rooms = panel.properties.rooms\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\t\ttemp = panel.properties.vacationTemperature\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\t\ttemp = panel.properties.handTemperature\n\t\t\t\t\tendTimestamp = panel.properties.handTimestamp\n\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t-- Otherwise we're in Auto mode\n\t\t\t\t\t-- We'll need to get the temperature and end time from the schedule\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\t\tlocal endDateTime = os.date(\"*t\")\n\t\t\t\t\tlocal scheduleToday = panel.properties[currentDay]\n\t\t\t\t\t\n\t\t\t\t\t-- If the night starts after midnight, then add on 24 hours\n\t\t\t\t\tif (scheduleToday.night.hour < scheduleToday.evening.hour) then\n\t\t\t\t\t\tscheduleToday.night.hour = scheduleToday.night.hour + 24\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- If we're before the morning period, then get the previous day's night\n\t\t\t\t\tif (currentMinutes < scheduleToday.morning.hour * 60 + scheduleToday.morning.minute) then\n\n\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal yesterday = os.date(\"%A\", os.time() - 24*60*60):lower()\n\t\t\t\t\t\tscheduleToday = panel.properties[yesterday]\n\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\n\t\t\t\t\telse\n\t\t\t\t\t\t\n\t\t\t\t\t\t-- If we're after then night period, then return that\n\t\t\t\t\t\tif (currentMinutes >= scheduleToday.night.hour * 60 + scheduleToday.night.minute) then \n\t\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- The End Time is tomorrow's morning time\n\t\t\t\t\t\t\tlocal tomorrow = os.date(\"%A\", currentTimestamp + 24*60*60):lower()\n\t\t\t\t\t\t\tscheduleToday = panel.properties[tomorrow]\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- Set the date to tomorrow's date\n\t\t\t\t\t\t\tlocal tomorrowDateTime = os.date(\"*t\", currentTimestamp+24*60*60)\n\t\t\t\t\t\t\tendDateTime.day = tomorrowDateTime.day\n\t\t\t\t\t\t\tendDateTime.month = tomorrowDateTime.month\n\t\t\t\t\t\t\tendDateTime.year = tomorrowDateTime.year\n\n\t\t\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t\t\t-- Otherwise find out which period of the day we're in\n\t\t\t\t\t\t\t-- and return the temperature for that period\n\t\t\t\t\t\t\tfor i, value in ipairs(periods) do\n\t\t\t\t\t\t\t\tif (currentMinutes < scheduleToday[value].hour * 60 + scheduleToday[value].minute) then\n\t\t\t\t\t\t\t\t\ttemp = scheduleToday[periods[i - 1]].temperature\n\n\t\t\t\t\t\t\t\t\tendDateTime.hour = scheduleToday[periods[i]].hour\n\t\t\t\t\t\t\t\t\tendDateTime.min = scheduleToday[periods[i]].minute\n\t\t\t\t\t\t\t\t\tendDateTime.sec = 0\n\n\t\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- Convert the Date/Time to a timestamp for Auto mode\n\t\t\t\t\tendTimestamp = os.time(endDateTime)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode, temp, endTimestamp, rooms\nend\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. tempUnit\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- getRoomTemperatures\n----------------------\n-- Get the temperatures of the rooms that the current zone has been assigned to\n\nfunction getRoomTemperatures(rooms)\n\t\n\tlocal roomTemps = \"\"\n\t\n\t\t-- For each room, get the default temperature sensor\n\t\tfor roomKey, roomValue in pairs(rooms) do\n\t\t\t\n\t\t\tlocal response ,status, errorCode = HC2:GET(\"/api/rooms/\" .. roomValue)\n\t\t\t\n\t\t\tif (status == \"200\") then\n\t\t\t  local room = json.decode(response)\n\t\t\t\t\n\t\t\t\tif (room ~= nil) then\n\t\t\t  \tlocal tempSensorId = room.defaultSensors.temperature\n\t\t\t  \t\n\t\t\t  \t-- Get the current value of the room's temperature sensor\n\t\t\t  \tif (tempSensorId ~= nil) then\n\t\t\t  \t\tresponse ,status, errorCode = HC2:GET(\"/api/devices/\" .. tempSensorId)\n\t\t\t  \t\tif (status == \"200\") then\n\t\t\t  \t\t\tlocal tempSensor = json.decode(response)\n\t\t\t  \t\t\t\n\t\t\t  \t\t\tif (tempSensor ~= nil) then\n\t\t\t  \t\t\t\tlocal temperature = tempSensor.properties.value\n\t\t\t  \t\t\t\t\n\t\t\t  \t\t\t\t-- Add the temperature to the return string\n\t\t\t  \t\t\t\tif (temperature ~= nil) then\n\t\t\t  \t\t\t\t\t-- First space is a non-breaking space (0xA0)\n\t\t\t  \t\t\t\t\troomTemps = roomTemps .. room.name .. \" \" .. temperature .. tempUnit .. \" \"\n\t\t\t  \t\t\t\tend\n\t\t\t  \t\t\tend\n\t\t\t  \t\tend\n\t\t\t  \tend\n\t\t\t  end\n\t\t\tend\n\t\tend\n\t\n\treturn roomTemps\nend\n\n--=============================================\n-- Main\n--=============================================\n-- Get the current zone\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the next Zone\nnextPanelName, nextPanelId = getNextZone(currentPanelId)\nnextZone = nextPanelName .. \" (\" ..nextPanelId .. \")\"\n\ntempUnit = getTemperatureUnit()\n\n-- Determine if the panel is currently under manual or vacation control\n-- and fetch the Override Temperature and Timestamp\ncurrentMode, panelOverrideTemp, panelEndTimestamp, panelRooms = getPanelDetails(nextPanelId)\n\ntempTimeLabel = formatTempTime(false, panelOverrideTemp, panelEndTimestamp)\n\n-- Get the current temperature of the rooms controlled by this zone\ncurrentTemps = getRoomTemperatures(panelRooms)\n\n-- Set Labels and Sliders\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", currentMode)\nfibaro:call(selfId, \"setProperty\", \"ui.zoneLabel.value\", nextZone)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.currentTempLabel.value\", currentTemps)\n","buttonIcon":0,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"Manual","name":"manualButton","empty":false,"msg":"--=============================================\n-- manualButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal newMode = \"Manual\"\nlocal currentMode = \"\"\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getPanelMode\n---------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n\nfunction getPanelMode(panelId)\n\n\tlocal mode = \"\"\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t\tfibaro:debug(\"Vac: \"..panel.properties.vacationTemperature .. \" Manual: \" ..panel.properties.handTemperature .. \" Time: \"..panel.properties.handTimestamp)\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\telse\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode\nend\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n-- Get current zone\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the current Panel mode\ncurrentMode = getPanelMode(currentPanelId)\n\n-- Get the current values from the Temp/Time label which may have been overridden\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- If there is no end time, because we're currently in vacation mode,\n-- then set it to 1 hour from now\nif (labelEndTimestamp == 0) then\n\tlabelEndTimestamp = currentTimestamp + 60*60\nend\n\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\n-- If not the same as the new mode, then prefix with an asterisk\n-- to indicate that the mode has been overridden\nif (newMode ~= currentMode) then\n\tnewMode = \"* \" .. newMode\nend\n\n-- Update the mode label\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", newMode)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\n","buttonIcon":0,"favourite":false,"main":false},{"id":4,"lua":true,"waitForResponse":false,"caption":"Vac","name":"vacationButton","empty":false,"msg":"--=============================================\n-- vacationButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal newMode = \"Vacation\"\nlocal currentMode = \"\"\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal labelTemp = 0\nlocal overridenTempTime = false\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getPanelMode\n---------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n\nfunction getPanelMode(panelId)\n\n\tlocal mode = \"\"\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t\tfibaro:debug(\"Vac: \"..panel.properties.vacationTemperature .. \" Manual: \" ..panel.properties.handTemperature .. \" Time: \"..panel.properties.handTimestamp)\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\telse\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode\nend\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n--=============================================\n-- Main\n--=============================================\n-- Get current zone\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the current Panel mode\ncurrentMode = getPanelMode(currentPanelId)\n\n-- If not the same as the new mode, then prefix with an asterisk\n-- to indicate that the mode has been overridden\nif (newMode ~= currentMode) then\n\tnewMode = \"* \" .. newMode\nend\n\n-- Default the vacation temperature to 10\nlabelTemp = 10\noverridenTempTime = true\nlabelEndTimestamp = 0\n\n-- Format the Temp/Time label\ntempTimeLabel = formatTempTime(overridenTempTime, labelTemp, labelEndTimestamp)\n\n-- Update the mode label\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", newMode)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\n","buttonIcon":0,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"Auto","name":"autoButton","empty":false,"msg":"--=============================================\n-- autoButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal newMode = \"Auto\"\nlocal currentMode = \"\"\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal panelTemp = 0\nlocal panelEndTimestamp = 0\nlocal overridenTempTime = false\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n-- getPanelAutoDetails\n----------------------\n-- Return the scheduled/auto settings for the selected panel\n\nfunction getPanelAutoDetails(panelId)\n\n\tlocal mode = \"\"\n\tlocal temp = 0\n\tlocal timestamp = 0\n\tlocal endTimestamp = 0\n\t\n\tlocal currentDay = os.date(\"%A\"):lower()  -- monday, tuesday etc\n\tlocal currentMinutes = os.date(\"%H\") * 60 + os.date(\"%M\")\n\tlocal periods = {\"morning\", \"day\", \"evening\", \"night\"}\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t\tfibaro:debug(\"Vac: \"..panel.properties.vacationTemperature .. \" Manual: \" ..panel.properties.handTemperature .. \" Time: \"..panel.properties.handTimestamp)\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\t\tendTimestamp = panel.properties.handTimestamp\n\t\t\t\telse\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\t-- We'll need to get the temperature and end time from the schedule\n\t\t\tlocal endHour = 0\n\t\t\tlocal endDateTime = os.date(\"*t\")\n\t\t\tlocal scheduleToday = panel.properties[currentDay]\n\t\t\t\n\t\t\t-- If the night starts after midnight, then add on 24 hours\n\t\t\tif (scheduleToday.night.hour < scheduleToday.evening.hour) then\n\t\t\t\tscheduleToday.night.hour = scheduleToday.night.hour + 24\n\t\t\tend\n\t\t\t\n\t\t\t-- If we're before the morning period, then get the previous day's night\n\t\t\tif (currentMinutes < scheduleToday.morning.hour * 60 + scheduleToday.morning.minute) then\n\n\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\n\t\t\t\tlocal yesterday = os.date(\"%A\", os.time() - 24*60*60):lower()\n\t\t\t\tscheduleToday = panel.properties[yesterday]\n\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\n\t\t\telse\n\t\t\t\t\n\t\t\t\t-- If we're after then night period, then return that\n\t\t\t\tif (currentMinutes >= scheduleToday.night.hour * 60 + scheduleToday.night.minute) then \n\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\n\t\t\t\t\t-- The End Time is tomorrow's morning time\n\t\t\t\t\tlocal tomorrow = os.date(\"%A\", currentTimestamp + 24*60*60):lower()\n\t\t\t\t\tscheduleToday = panel.properties[tomorrow]\n\t\t\t\t\t\n\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t-- Set the date to tomorrow's date\n\t\t\t\t\tlocal tomorrowDateTime = os.date(\"*t\", currentTimestamp+24*60*60)\n\t\t\t\t\tendDateTime.day = tomorrowDateTime.day\n\t\t\t\t\tendDateTime.month = tomorrowDateTime.month\n\t\t\t\t\tendDateTime.year = tomorrowDateTime.year\n\t\t\t\telse\n\t\t\t\n\t\t\t\t\t-- Otherwise find out which period of the day we're in\n\t\t\t\t\t-- and return the temperature for that period\n\t\t\t\t\tfor i, value in ipairs(periods) do\n\t\t\t\t\t\tif (currentMinutes < scheduleToday[value].hour * 60 + scheduleToday[value].minute) then\n\t\t\t\t\t\t\ttemp = scheduleToday[periods[i - 1]].temperature\n\n\t\t\t\t\t\t\tendDateTime.hour = scheduleToday[periods[i]].hour\n\t\t\t\t\t\t\tendDateTime.min = scheduleToday[periods[i]].minute\n\t\t\t\t\t\t\tendDateTime.sec = 0\n\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\t-- Convert the Date/Time to a timestamp for Auto mode\n\t\t\tendTimestamp = os.time(endDateTime)\n\t\tend\n\tend\n\t\n\treturn mode, temp, endTimestamp\nend\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n-- Get current zone\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the current scheduled/auto setting from the Panel\n-- and the current mode\ncurrentMode, panelTemp, panelEndTimestamp = getPanelAutoDetails(currentPanelId)\n\n-- If not the same as the new mode, then prefix with an asterisk\n-- to indicate that the mode has been overridden\nif (newMode ~= currentMode) then\n\tnewMode = \"* \" .. newMode\n\toverridenTempTime = true\nend\n\n-- Format the Temp/Time label\ntempTimeLabel = formatTempTime(overridenTempTime, panelTemp, panelEndTimestamp)\n\n-- Update the labels\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", newMode)\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\n","buttonIcon":0,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"Reset","name":"resetButton","empty":false,"msg":"--=============================================\n-- resetButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal panelTemp = 0\nlocal panelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n-- getPanelDetails\n------------------\n-- Return the mode (Auto, Manual, Vacation) for the selected panel\n-- As well as the override temperature and manual End Time\n\nfunction getPanelDetails(panelId)\n\n\tlocal mode = \"\"\n\tlocal temp = 0\n\tlocal timestamp = 0\n\tlocal endTimestamp = 0\n\tlocal rooms = {}\n\t\n\tlocal currentDay = os.date(\"%A\"):lower()  -- monday, tuesday etc\n\tlocal currentMinutes = os.date(\"%H\") * 60 + os.date(\"%M\")\n\tlocal periods = {\"morning\", \"day\", \"evening\", \"night\"}\n\t\n\t-- Determine if the panel is current under manual or vacation control\n\tif (panelId ~= 0) then\n\t\t\n\t\t-- Get the panel details\n\t\tlocal response, status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t  \n\t\t  rooms = panel.properties.rooms\n\t\t\t\n\t\t\tif (panel.properties.vacationTemperature > 0) then\n\t\t\t\tmode = \"Vacation\"\n\t\t\t\ttemp = panel.properties.vacationTemperature\n\t\t\telse\n\t\t\t\tif (panel.properties.handTemperature > 0\n\t\t\t\tand panel.properties.handTimestamp > currentTimestamp) then\n\t\t\t\t\tmode = \"Manual\"\n\t\t\t\t\ttemp = panel.properties.handTemperature\n\t\t\t\t\tendTimestamp = panel.properties.handTimestamp\n\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t-- Otherwise we're in Auto mode\n\t\t\t\t\t-- We'll need to get the temperature and end time from the schedule\n\t\t\t\t\tmode = \"Auto\"\n\t\t\t\t\tlocal endDateTime = os.date(\"*t\")\n\t\t\t\t\tlocal scheduleToday = panel.properties[currentDay]\n\t\t\t\t\t\n\t\t\t\t\t-- If the night starts after midnight, then add on 24 hours\n\t\t\t\t\tif (scheduleToday.night.hour < scheduleToday.evening.hour) then\n\t\t\t\t\t\tscheduleToday.night.hour = scheduleToday.night.hour + 24\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- If we're before the morning period, then get the previous day's night\n\t\t\t\t\tif (currentMinutes < scheduleToday.morning.hour * 60 + scheduleToday.morning.minute) then\n\n\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\n\t\t\t\t\t\tlocal yesterday = os.date(\"%A\", os.time() - 24*60*60):lower()\n\t\t\t\t\t\tscheduleToday = panel.properties[yesterday]\n\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\n\t\t\t\t\telse\n\t\t\t\t\t\t\n\t\t\t\t\t\t-- If we're after then night period, then return that\n\t\t\t\t\t\tif (currentMinutes >= scheduleToday.night.hour * 60 + scheduleToday.night.minute) then \n\t\t\t\t\t\t\ttemp = scheduleToday.night.temperature\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- The End Time is tomorrow's morning time\n\t\t\t\t\t\t\tlocal tomorrow = os.date(\"%A\", currentTimestamp + 24*60*60):lower()\n\t\t\t\t\t\t\tscheduleToday = panel.properties[tomorrow]\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tendDateTime.hour = scheduleToday.morning.hour\n\t\t\t\t\t\t\tendDateTime.min = scheduleToday.morning.minute\n\t\t\t\t\t\t\tendDateTime.sec = 0\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t-- Set the date to tomorrow's date\n\t\t\t\t\t\t\tlocal tomorrowDateTime = os.date(\"*t\", currentTimestamp+24*60*60)\n\t\t\t\t\t\t\tendDateTime.day = tomorrowDateTime.day\n\t\t\t\t\t\t\tendDateTime.month = tomorrowDateTime.month\n\t\t\t\t\t\t\tendDateTime.year = tomorrowDateTime.year\n\n\t\t\t\t\t\telse\n\t\t\t\t\t\n\t\t\t\t\t\t\t-- Otherwise find out which period of the day we're in\n\t\t\t\t\t\t\t-- and return the temperature for that period\n\t\t\t\t\t\t\tfor i, value in ipairs(periods) do\n\t\t\t\t\t\t\t\tif (currentMinutes < scheduleToday[value].hour * 60 + scheduleToday[value].minute) then\n\t\t\t\t\t\t\t\t\ttemp = scheduleToday[periods[i - 1]].temperature\n\n\t\t\t\t\t\t\t\t\tendDateTime.hour = scheduleToday[periods[i]].hour\n\t\t\t\t\t\t\t\t\tendDateTime.min = scheduleToday[periods[i]].minute\n\t\t\t\t\t\t\t\t\tendDateTime.sec = 0\n\n\t\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\t\tend\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\t\t\n\t\t\t\t\t-- Convert the Date/Time to a timestamp for Auto mode\n\t\t\t\t\tendTimestamp = os.time(endDateTime)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\t\n\treturn mode, temp, endTimestamp, rooms\nend\n\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Have a mode and zone already been selected?\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the current values from the Heating Panel\ncurrentMode, panelTemp, panelEndTimestamp = getPanelDetails(currentPanelId)\n\ntempTimeLabel = formatTempTime(overridenTempOrTime, panelTemp, panelEndTimestamp)\n\n-- Clear the current mode and temp/time so that they refresh from the main loop\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", currentMode)\n","buttonIcon":0,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":7,"lua":false,"waitForResponse":false,"caption":"Zone:","name":"zoneLabel","favourite":false,"main":false}]},{"type":"label","elements":[{"id":8,"lua":false,"waitForResponse":false,"caption":"Mode:","name":"modeLabel","favourite":false,"main":false}]},{"type":"button","elements":[{"id":9,"lua":true,"waitForResponse":false,"caption":"- °C","name":"tempDownButton","empty":false,"msg":"--=============================================\n-- tempDownButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal minTemp = 4\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Increase the temperature and set the override flag\noverridenTempOrTime = true\nlabelTemp = labelTemp - 1\n\nif (labelTemp < minTemp) then\n\tlabelTemp = minTemp\nend\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":10,"lua":true,"waitForResponse":false,"caption":"+ °C","name":"tempUpButton","empty":false,"msg":"--=============================================\n-- tempUpButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal maxTemp = 33\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Increase the temperature and set the override flag\noverridenTempOrTime = true\nlabelTemp = labelTemp + 1\n\nif (labelTemp > maxTemp) then\n\tlabelTemp = maxTemp\nend\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":11,"lua":true,"waitForResponse":false,"caption":"- H","name":"timeDownButton","empty":false,"msg":"--=============================================\n-- timeDownButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- decreaseEndDateTime\n----------------------\n-- Decrease the End Date and Time by the number of minutes\n-- specified\nfunction decreaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Decrease by the minutes required\n\t\tendTimestamp = endTimestamp - decreaseMinutes*60\n\t\t\n\t\t-- If less than the current timestamp, then add on 24 hours\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Decrease the date and time\nlocal decreaseMinutes = 60\nlabelEndTimestamp = decreaseEndDateTime(labelEndTimestamp, decreaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":12,"lua":true,"waitForResponse":false,"caption":"+ H","name":"timeUpButton","empty":false,"msg":"--=============================================\n-- timeUpButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelDurationMins = 0\nlocal labelEndTime = \"\"\nlocal labelEndDate = \"\"\nlocal endHour = 0\nlocal endMinute = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- increaseEndDateTime\n----------------------\n-- Increase the End Date and Time by the number of minutes\n-- specified\nfunction increaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Increase by the minutes required\n\t\tendTimestamp = endTimestamp + decreaseMinutes*60\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Increase the date and time\nlocal increaseMinutes = 60\nlabelEndTimestamp = increaseEndDateTime(labelEndTimestamp, increaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":13,"lua":true,"waitForResponse":false,"caption":"- D","name":"dayDownButton","empty":false,"msg":"--=============================================\n-- dayDownButton\n--=============================================\n--====================