.. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- decreaseEndDateTime\n----------------------\n-- Decrease the End Date and Time by the number of minutes\n-- specified\nfunction decreaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Decrease by the minutes required\n\t\tif (currentTimestamp < endTimestamp - decreaseMinutes*60) then\n\t\t\tendTimestamp = endTimestamp - decreaseMinutes*60\n\t\tend\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Decrease the date and time\nlocal decreaseMinutes = 24*60\nlabelEndTimestamp = decreaseEndDateTime(labelEndTimestamp, decreaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":1001,"favourite":false,"main":false},{"id":14,"lua":true,"waitForResponse":false,"caption":"+ D","name":"dayUpButton","empty":false,"msg":"--=============================================\n-- dayUpButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelDurationMins = 0\nlocal labelEndTime = \"\"\nlocal labelEndDate = \"\"\nlocal endHour = 0\nlocal endMinute = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- increaseEndDateTime\n----------------------\n-- Increase the End Date and Time by the number of minutes\n-- specified\nfunction increaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Increase by the minutes required\n\t\tendTimestamp = endTimestamp + decreaseMinutes*60\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Increase the date and time\nlocal increaseMinutes = 24*60\nlabelEndTimestamp = increaseEndDateTime(labelEndTimestamp, increaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":1001,"favourite":false,"main":false},{"id":15,"lua":true,"waitForResponse":false,"caption":"- W","name":"weekDownButton","empty":false,"msg":"--=============================================\n-- weekDownButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- decreaseEndDateTime\n----------------------\n-- Decrease the End Date and Time by the number of minutes\n-- specified\nfunction decreaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Decrease by the minutes required\n\t\tif (currentTimestamp < endTimestamp - decreaseMinutes*60) then\n\t\t\tendTimestamp = endTimestamp - decreaseMinutes*60\n\t\tend\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Decrease the date and time\nlocal decreaseMinutes = 7*24*60\nlabelEndTimestamp = decreaseEndDateTime(labelEndTimestamp, decreaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":1001,"favourite":false,"main":false},{"id":16,"lua":true,"waitForResponse":false,"caption":"+ W","name":"weekUpButton","empty":false,"msg":"--=============================================\n-- weekUpButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelDurationMins = 0\nlocal labelEndTime = \"\"\nlocal labelEndDate = \"\"\nlocal endHour = 0\nlocal endMinute = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- increaseEndDateTime\n----------------------\n-- Increase the End Date and Time by the number of minutes\n-- specified\nfunction increaseEndDateTime(endTimestamp, decreaseMinutes)\n\n\t-- Only decrease if we're currently displaying a time\n\tif (endTimestamp ~= 0) then\n\t\t\n\t\t-- Increase by the minutes required\n\t\tendTimestamp = endTimestamp + decreaseMinutes*60\n\tend\n\t\n\treturn endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the override flag\noverridenTempOrTime = true\n\n-- Increase the date and time\nlocal increaseMinutes = 7*24*60\nlabelEndTimestamp = increaseEndDateTime(labelEndTimestamp, increaseMinutes)\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":1001,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":17,"lua":true,"waitForResponse":false,"caption":"10°C","name":"tenDegreeButton","empty":false,"msg":"--=============================================\n-- tenDegreeButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal overrideTemp = 10\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the temperature and override flag\noverridenTempOrTime = true\nlabelTemp = overrideTemp\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":18,"lua":true,"waitForResponse":false,"caption":"21°C","name":"twentyoneDegreeButton","empty":false,"msg":"--=============================================\n-- twentyOneDegreeButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal overrideTemp = 21\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the temperature and override flag\noverridenTempOrTime = true\nlabelTemp = overrideTemp\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":19,"lua":true,"waitForResponse":false,"caption":"1 Hr","name":"oneHourButton","empty":false,"msg":"--=============================================\n-- oneHourButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal overrideDurationHours = 1\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the duration to 1 hour and set the override flag\n-- but only if we're currently displaying a time\nif (labelEndTimestamp ~= 0) then \n\toverridenTempOrTime = true\n\tlabelEndTimestamp = currentTimestamp + overrideDurationHours*60*60\nend\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false},{"id":20,"lua":true,"waitForResponse":false,"caption":"2 Hrs","name":"twoHourButton","empty":false,"msg":"--=============================================\n-- twoHourButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal overrideDurationHours = 2\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n-- getTemperatureUnit\n---------------------\n-- Return the temperature unit from the system settings\n\nfunction getTemperatureUnit()\n\n\t-- Default to °C just in case the api call fails\n\tlocal tempUnit = \"°C\"\n\t\n\t-- Get the Temperature Unit\n\tlocal response ,status, errorCode = HC2:GET(\"/api/settings/info/\")\n\tlocal info = json.decode(response)\n\t\n\tif (status == \"200\") then\n\t\ttempUnit = \"°\" .. info.temperatureUnit\n\telse\n\t\tfibaro:debug(\"Unable to get the temperature unit\")\n\tend\n\t\n\treturn tempUnit\nend\n\n-- formatTempTime\n-----------------\n-- Format the Temperature and Time into a string so that\n-- we can output to a label\n\nfunction formatTempTime(override, temp, endTimestamp)\n\n\tlocal label = \"\"\n\t\n\tif (override) then\n\t\tlabel = \"* \"\n\tend\n\t\n\tlabel = label .. temp .. getTemperatureUnit()\n\t\n\tif (endTimestamp > 0) then\n\t\tlocal duration = math.ceil((endTimestamp - currentTimestamp) / 60)\n\t\n\t\tlocal days = math.floor(duration / (24*60))\n\t\tlocal hours = math.floor((duration - days*24*60) / 60)\n\t\tlocal minutes = math.floor(duration - days*24*60 - hours*60)\n\t\t\n\t\tlabel = label .. \" for \"\n\t\t\n\t\tif (days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", days) .. \"d \"\n\t\tend\n\t\t\n\t\tif (hours > 0 or days > 0) then\n\t\t\tlabel = label .. string.format(\"%d\", hours) .. \"h \"\n\t\tend\n\t\t\n\t\tlabel = label .. string.format(\"%d\", minutes) .. \"m\"\n\t\t\n\t\tlabel = label .. \" until \" .. os.date(\"%H:%M\", endTimestamp)\n\t\t\n\t\t-- Only output the date if more than 24 hours from now\n\t\tif (endTimestamp >= currentTimestamp + 24*60*60) then\n\t\t\tlabel = label .. \" \" .. os.date(\"%A %d/%m/%Y\", endTimestamp)\n\t\tend\n\tend\n\t\n\treturn label\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\n\n-- Override the mode to Manual unless already set to Manual or Vacation\n-- Prefix with the asterisk to signify that the mode has been overridden\nif (currentMode == \"Auto\") then\n\toverrideMode = \"* Manual\"\nelse\n\toverrideMode = currentMode\nend\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\nfibaro:debug(tempTimeLabel)\n\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Set the duration to 2 hours and set the override flag\n-- but only if we're currently displaying a time\nif (labelEndTimestamp ~= 0) then \n\toverridenTempOrTime = true\n\tlabelEndTimestamp = currentTimestamp + overrideDurationHours*60*60\nend\n\n-- Reformat the label\ntempTimeLabel = formatTempTime(overridenTempOrTime, labelTemp, labelEndTimestamp)\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", overrideMode)\n","buttonIcon":0,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":21,"lua":false,"waitForResponse":false,"caption":"","name":"tempTimeLabel","favourite":false,"main":false}]},{"type":"label","elements":[{"id":22,"lua":false,"waitForResponse":false,"caption":"","name":"currentTempLabel","favourite":false,"main":false}]},{"type":"button","elements":[{"id":23,"lua":true,"waitForResponse":false,"caption":"Set","name":"setButton","empty":false,"msg":"--=============================================\n-- setButton\n--=============================================\n--=============================================\n-- Declarations\n--=============================================\nlocal selfId = fibaro:getSelfId()\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = \"\"\nlocal currentMode = \"\"\nlocal overrideMode = \"\"\nlocal tempTimeLabel = \"\"\nlocal overridenTempOrTime = false\nlocal labelTemp = 0\nlocal labelEndTimestamp = 0\nlocal currentTimestamp = os.time()\n\nif (not HC2) then\n  HC2 = Net.FHttp(\"127.0.0.1\", 11111)\nend\n\n--=============================================\n-- Functions\n--=============================================\n\n-- getPanelNameAndId\n--------------------\n-- Return the Heating Panel Name and Id from the Zone\n-- Format of the zone is NNNNNNNNNNNNN (DDD)\n-- where NNNNNNNNNNNNN is the Heating Panel Name\n-- and DDD is the Panel Id\n\nfunction getPanelNameAndId(zone)\n\t-- The zone contains the Panel Name and Id in parentheses\n\tlocal start, finish = string.find(zone, \"%(%d+%)\")\n\t\n\tlocal zoneName = string.sub(zone, 1, start - 2) -- There is a space before the '('\n\tlocal zoneId = string.sub(zone, start + 1, finish - 1)\n\t\n\treturn zoneName, zoneId\nend\n\n-- deformatTempTime\n-------------------\n-- Extract the temperature, duration and end time and date\n-- from the Temp/Time label\n\nfunction deformatTempTime(tempTime)\n\tlocal override = false\n\tlocal temp = 0\n\tlocal endTimestamp = 0\n\tlocal endTime = \"\"\n\tlocal endDate = \"\"\n\tlocal pos = 1\n\t\n\t-- Has the temperature or time been overridden?\n\tif (tempTimeLabel:sub(pos,1) == \"*\") then\n\t\toverride = true\n\t\tpos = pos + 1\n\tend\n\t\n\t-- Find the temperature = the first number\n\tlocal start, finish = tempTime:find(\"%d+\", pos)\n\t\n\tif (start ~= nil) then\n\t\ttemp = tonumber(tempTime:sub(start, finish))\n\t\tpos = finish + 1\n\tend\n\t\n\t-- Find the End Time\n\tstart, finish = tempTime:find(\"%d+:%d+\", pos)\n\tif (start ~= nil) then\n\t\tendTime = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Find the End Date\n\tstart, finish = tempTime:find(\"%d+/%d+/%d+\", pos)\n\tif (start ~= nil) then\n\t\tendDate = tempTime:sub(start, finish)\n\tend\n\t\n\t-- Convert the date and time to a timestamp\n\tif (endTime ~= nil and endTime ~= \"\") then\n\t\t\n\t\t-- Assume that the End Time is today\n\t\tlocal dateTime = os.date(\"*t\")\n\t\tdateTime.hour = tonumber(endTime:sub(1,2))\n\t\tdateTime.min = tonumber(endTime:sub(4,5))\n\t\tdateTime.sec = 0\n\n\t\t-- Do we have a date?\n\t\tif (endDate ~= nil and endDate ~= \"\") then\n\t\t\tdateTime.day = tonumber(endDate:sub(1,2))\n\t\t\tdateTime.month = tonumber(endDate:sub(4,5))\n\t\t\tdateTime.year = tonumber(endDate:sub(7,10))\n\t\tend\n\t\t\n\t\tendTimestamp = os.time(dateTime)\n\t\t\n\t\t-- If the timestamp is less than the current timestamp, then add on a day\n\t\tif (endTimestamp < currentTimestamp) then\n\t\t\tendTimestamp = endTimestamp + 24*60*60\n\t\tend\n\tend\n\t\n\treturn override, temp, endTimestamp\nend\n\n-- setPanelOverride\n-------------------\n-- Override the panel with either Manual or Vacation settings\n-- Or revert to Auto if the Manual and Vacation temperatures are zero\n\nfunction setPanelOverride(panelId, mode, overrideTemp, overrideTimestamp)\n\n\tif (panelId ~= 0) then\n\t\n\t\t-- Get the panel details\n\t\tlocal response ,status, errorCode = HC2:GET(\"/api/panels/heating/\" .. panelId)\n\t\t\n\t\tif (status == \"200\") then\n\t\t  local panel = json.decode(response)\n\t\t  \n\t\t  if (mode == \"Auto\" or mode == \"* Auto\") then\n\t\t\t  panel.properties.handTemperature = 0\n\t\t\t  panel.properties.handTimestamp = currentTimestamp\n\t\t\t  panel.properties.vacationTemperature = 0\n\t\t\t  \n\t\t  elseif (mode == \"Manual\" or mode == \"* Manual\") then\n\t\t\t  panel.properties.handTemperature = overrideTemp\n\t\t\t  panel.properties.handTimestamp = overrideTimestamp\n\t\t\t  panel.properties.vacationTemperature = 0\n\t\t\t  \n\t\t\telseif (mode == \"Vacation\" or mode == \"* Vacation\") then\n\t\t\t  panel.properties.handTemperature = 0\n\t\t\t  panel.properties.handTimestamp = currentTimestamp\n\t\t\t  panel.properties.vacationTemperature = overrideTemp\n\t\t\tend\n\n\t\t\t-- Update the panel\n\t\t  response ,status, errorCode = HC2:PUT(\"/api/panels/heating/\" .. panelId, json.encode(panel))\n\t\tend\n\tend\nend\n\n--=============================================\n-- Main\n--=============================================\n\n-- Get the current mode and zone\ncurrentMode = fibaro:get(selfId, \"ui.modeLabel.value\")\ncurrentZone = fibaro:get(selfId, \"ui.zoneLabel.value\")\n\n-- Get the current Panel Name and Id from the zone description\ncurrentPanelName, currentPanelId = getPanelNameAndId(currentZone)\n\n-- Get the current Temp/Time label and deformat it\ntempTimeLabel = fibaro:get(selfId, \"ui.tempTimeLabel.value\")\noverridenTempOrTime, labelTemp, labelEndTimestamp = deformatTempTime(tempTimeLabel)\n\n-- Update the panel with the override settings\nsetPanelOverride(currentPanelId, currentMode, labelTemp, labelEndTimestamp)\n\n-- Remove the override asterisks from the Mode and Temp/Time label\nif (currentMode:sub(1,1) == \"*\") then\n\tcurrentMode = currentMode:sub(3)\nend\n\nif (tempTimeLabel:sub(1,1) == \"*\") then\n\ttempTimeLabel = tempTimeLabel:sub(3)\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.tempTimeLabel.value\", tempTimeLabel)\nfibaro:call(selfId, \"setProperty\", \"ui.modeLabel.value\", currentMode)\n","buttonIcon":0,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}