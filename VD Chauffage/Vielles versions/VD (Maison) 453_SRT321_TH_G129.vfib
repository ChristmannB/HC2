{"name":"453 SRT321 TH (G129)","type":"virtual_device","properties":{"deviceIcon":1046,"categories":"[\"other\"]","currentIcon":"1046","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% events\n%% globals\nConsigne\n--]]\n\n--fibaro:getSourceTrigger()\nlocal SRT321 = 575 -- Thermostat SRTGEN4=28\nlocal Temp = 576 -- Sonde de température SRTGEN5 = 123\nlocal VD_ID = fibaro:getSelfId() --535\nlocal val = fibaro:getValue(Temp, \"value\") -- current temp\nlocal TARGET = fibaro:getValue(SRT321, \"targetLevel\") -- target temp\nlocal time = (fibaro:getValue(SRT321, \"timestamp\")) -- timestamp command reception\nlocal heure = os.date(\"%H:%M\", time)\n--local interval = (fibaro:getValue(SRT321, \"interval\"))\nlocal log =( fibaro:getValue(SRT321, \"log\"))\n\n--fibaro:call(VD_ID,'setProperty','ui.Label1.value', Cons)\n\nfibaro:debug(\"ID SRT321 \" .. SRT321)\nfibaro:debug(\"Température actuelle : \" .. val ..\"°C\")\n--fibaro:debug(\"Consigne : \" .. Consigne .. \"°C\")\nfibaro:debug(\"Consigne actuelle à \" .. TARGET .. \"°C\")\n\nlocal Cons = fibaro:getGlobal(\"CONS_SALONG_324\")\nfibaro:debug(\"Nouvelle consigne à \" .. Cons .. \"°C\")\n-- Action reprogrammation  de la consigne du SRT321\nfibaro:call(SRT321, \"setTargetLevel\", Cons)\n-- Affichage sur VD de la nouvelle Consigne\nfibaro:call(VD_ID,'setProperty','ui.Label1.value', Cons)\n-- Attente\nfibaro:sleep(1000)\nTARGET2 = (fibaro:getValue(SRT321, \"targetLevel\"))\nfibaro:debug(\"Nouvelle consigne est \" .. TARGET2 .. \"°C\")\nfibaro:debug(\"commande reçue à \".. time)\nfibaro:debug(\"Horaire \"  .. heure)\n--fibaro:debug(\"Durée de \" .. interval)\nfibaro:debug(log)\nfibaro:call(VD_ID,'setProperty','ui.Label2.value', log)\n\n--fibaro:sleep(1*1*900*1000)\nlocal log2 = fibaro:getValue(SRT321, \"log\")\nfibaro:debug(log2)\nfibaro:call(VD_ID,'setProperty','ui.Label2.value', log2)\n\n--fibaro:abort()","ui.Label1.value":"7","ui.Label2.value":"","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":true,"waitForResponse":false,"caption":"Hors Gel","name":"Button11","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" ,7)\nfibaro:log(\"Consigne mise à 7°C\")","buttonIcon":1054,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"+","name":"Button21","empty":false,"msg":"local SRT321 = 575\nlocal Cons3 = fibaro:getValue(SRT321, \"targetLevel\")\nfibaro:setGlobal(\"CONS_SALONG_324\", tonumber(Cons3)+1)\n--\nfibaro:log(\"Consigne augmentée de 1°C\")","buttonIcon":1048,"favourite":false,"main":false},{"id":3,"lua":true,"waitForResponse":false,"caption":"-","name":"Button22","empty":false,"msg":"local SRT321 = 575\nlocal Cons3 = fibaro:getValue(SRT321, \"targetLevel\")\nfibaro:setGlobal(\"CONS_SALONG_324\", tonumber(Cons3)-1)\n--\nfibaro:log(\"Consigne diminuée de 1°C\")","buttonIcon":1048,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":true,"waitForResponse":false,"caption":"18°","name":"Button31","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" , 18)\nfibaro:log(\"Consigne mise à 18°C\")","buttonIcon":1049,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"19°","name":"Button32","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" , 19)\nfibaro:log(\"Consigne mise à 19°C\")","buttonIcon":1052,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"20°","name":"Button33","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" , 20)\nfibaro:log(\"Consigne mise à 20°C\")","buttonIcon":1050,"favourite":false,"main":false},{"id":7,"lua":true,"waitForResponse":false,"caption":"21°","name":"Button34","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" , 21)\nfibaro:log(\"Consigne mise à 21°C\")","buttonIcon":1051,"favourite":false,"main":false},{"id":8,"lua":true,"waitForResponse":false,"caption":"22°","name":"Button35","empty":false,"msg":"fibaro:setGlobal(\"CONS_SALONG_324\" , 22)\n\nfibaro:log(\"Consigne mise à 22°C\")","buttonIcon":1053,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":9,"lua":false,"waitForResponse":false,"caption":"Consigne en°C","name":"Label1","favourite":false,"main":true}]},{"type":"label","elements":[{"id":10,"lua":false,"waitForResponse":false,"caption":"Etat","name":"Label2","favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}