{"name":"597 Thrmst Salon","type":"virtual_device","properties":{"deviceIcon":1082,"categories":"[\"climate\"]","currentIcon":"1082","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% events\n%% globals\nConsigne_G\nSRT123_ID\n--]]\n\nlocal VDID = fibaro:getSelfId()\n--définition du SRT à commander dans la variable globale SRT123_ID\nlocal SRT123iD = 597\t\tfibaro:setGlobal(\"SRT123_ID\",597) \nlocal Temp = 598 -- Sonde de température couplée au SRTGEN5\n\t\tfibaro:debug(\"le SRT à piloter a pour ID : 597 et la sonde de T° 598\")\n\n--\t\tfibaro:debug(\"Ce VD SRT321_\" .. SRT123_ID ..\" a pour ID :  \" .. VDID )\nlocal ROOMID = fibaro:getRoomID(VDID)\n\t\tfibaro:setGlobal(\"piece\", ROOMID)\n\t\tfibaro:debug(\"La pièce de ce VD a pour ID :  \" .. ROOMID )\nlocal NomPiece = fibaro:getRoomName(ROOMID)\n\t\tfibaro:debug(\"La pièce de ce VD a pour nom :  \" ..  NomPiece )\n\nlocal val = (fibaro:getValue(Temp, \"value\")) -- current temp\n\tfibaro:debug(\"Température actuelle : \" .. val ..\"°C\")\n\nlocal setp = fibaro:getValue(SRT123iD, \"value\") -- Consigne de T° lue\n\tfibaro:debug(\"Consigne actuelle à \" .. setp .. \"°C\")\nlocal Cons = fibaro:getGlobal(\"Consigne_G\") -- consigne demandée\n\tfibaro:debug(\"Nouvelle consigne : \" .. Cons .. \"°C\")\nif (Cons == setp)\n  then\n  fibaro:debug(\"On ne fait rien\")\n  else\n--local interval = (fibaro:getValue(SRT123_ID, \"interval\"))\n\nfibaro:call(VDID,'setProperty','ui.Label1.value', Cons .. \"°C\")  -- ajout  .. \"°C\" -- Affichage de la nouvelle consigne\n\n--fibaro:call(597, \"value\", Cons) \n--  fibaro:setvalue(597, Cons) -- envoi de la nouvelle consigne au SRT\n--  fibaro:call(597, \"setThermostatSetpoint\", \"1\", cons)\n  --fibaro:call(597, \"setPoint\", cons)\n fibaro:call(SRT123iD, \"setTargetLevel\", Cons)\nfibaro:debug(\"Nouvelle consigne à \" .. Cons .. \"°C - Commande envoyée\" )\n\n  fibaro:debug(\"fin\")\n--local log =( fibaro:getValue(SRT123_ID, \"log\"))\nlocal log = fibaro:getValue(SRT123iD, \"log\")\nfibaro:debug(\"Etat : \" .. log)\nfibaro:call(VDID,'setProperty','ui.Label2.value', log)  --\n  --\n  end\n--local log =( fibaro:getValue(597, \"log\"))\n--fibaro:debug(\"Etat : \" .. log)\nfibaro:debug(\"Attente de 5 secondes\")\nfibaro:sleep(5*1000)\nlog = fibaro:getValue(SRT123iD, \"log\")\nfibaro:call(VDID,'setProperty','ui.Label2.value', log)  --\n\n--setp2 = (fibaro:getValue(SRT123_ID, \"value\"))\n--fibaro:debug(\"Nouvelle consigne est \" .. setp2 .. \"°C\")\n--local time = (fibaro:getValue(SRT123_ID, \"timestamp\")) -- timestamp command reception\n--local heure = os.date(\"%H:%M\", time)\n--fibaro:debug(\"commande reçue à \".. time)\n--fibaro:debug(\"Horaire \"  .. heure)\n--fibaro:debug(\"Durée de \" .. interval)\n\n","ui.Label1.value":"7°C","ui.Label2.value":"Waiting for Wakeup","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":true,"waitForResponse":false,"caption":"Hors Gel","name":"Button11","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 7)\n","buttonIcon":1083,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"- 1°C","name":"Button21","empty":false,"msg":"local SRT321 = 597\nfibaro:setGlobal(\"Consigne_G\",  tonumber (fibaro:getValue(SRT321, \"targetLevel\"))-1)\nfibaro:debug(\"La consigne est maintenant de \" .. Consigne_G .. \"°C\")\nfibaro:setvalue(SRT321, Consigne_G)","buttonIcon":1090,"favourite":false,"main":false},{"id":3,"lua":true,"waitForResponse":false,"caption":"+ 1°C","name":"Button22","empty":false,"msg":"local SRT321 = 597\nfibaro:setGlobal(\"Consigne_G\",  tonumber (fibaro:getValue(SRT321, \"targetLevel\"))+1)\nfibaro:debug(\"La consigne est maintenant de \" .. Consigne_G .. \"°C\")","buttonIcon":1090,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":true,"waitForResponse":false,"caption":"18°","name":"Button31","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 18)\n","buttonIcon":1085,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"19°","name":"Button32","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 19)\n","buttonIcon":1086,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"20°","name":"Button33","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 20)\n","buttonIcon":1087,"favourite":false,"main":false},{"id":7,"lua":true,"waitForResponse":false,"caption":"21°","name":"Button34","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 21)\n","buttonIcon":1088,"favourite":false,"main":false},{"id":8,"lua":true,"waitForResponse":false,"caption":"22°","name":"Button35","empty":false,"msg":"  fibaro:setGlobal(\"Consigne_G\", 22)\n","buttonIcon":1089,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":9,"lua":false,"waitForResponse":false,"caption":"Consigne T°","name":"Label1","favourite":false,"main":true}]},{"type":"label","elements":[{"id":10,"lua":false,"waitForResponse":false,"caption":"Etat : ","name":"Label2","favourite":true,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}