{"name":"Chauffage Maison","type":"virtual_device","properties":{"deviceIcon":59,"categories":"[\"remotes\"]","currentIcon":"59","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% globals\nMode_Maison\n--]]\n-- démarrage de la boucle\n--while true do\n-- Utilisation de l'heure et de la date\nlocal Maintenant = os.date(\"*t\") --stocke la date et heure actuelle du système sous forme d'un tableau à l'intérieur de la variable \"Maintenant\"\n--  Affichage de la date et l'heure\nfibaro:debug(\"il est maintenant \".. Maintenant['hour']..\"h\"..Maintenant['min']..\"min\"..\", le \"..Maintenant['day']..\"/\"..Maintenant['month']..\"/\"..Maintenant['year'])\n\n--recherche de la valeur du mode : \nlocal valueHouseMode = fibaro:getGlobal('Mode_Maison')\nfibaro:debug('Le chauffage est en mode ' .. valueHouseMode )\n\n-- Affichage du label1\nfibaro:call(87,'setProperty','ui.Label1.value', valueHouseMode)\n\n-- Test do Mode\n    if (valueHouseMode=='Automatique')\n    then fibaro:debug (\"Mise en marche du mode Automatique\")\n  \t\t fibaro:startScene(2)\n    \t fibaro:startScene(12)\n\telseif \t(valueHouseMode=='Hors_Gel')\n  \t\tthen fibaro:debug (\"Mise en marche du Hors Gel\")\n  \t\t     fibaro:startScene(5)\n  \t\t\telseif (valueHouseMode=='Presence')\n  \t\tthen fibaro:debug (\"Mise en marche du Chauffage permanent\")\n  \t\t     --fibaro:startScene(6) -- 23/06/2019 la scène 6 n'existe plus\n    \t\t fibaro:startScene(12)\n  \t\t\t fibaro:killScenes(2)\n  \t\t\t fibaro:killScenes(9)\n  \t\t\t fibaro:killScenes(5)\n  \n  \n  \t\t\t\telseif (valueHouseMode=='STOP')\n  \t\t\t\tthen fibaro:debug (\"Mise à l'arrêt du module Chauffage\")\n  \t\t\t\t\t fibaro:startScene(9) -- mise en mode OFF des switchs\n  \t\t\t\t\t\t\t\t\t\t  -- Switch Direct\n  \t\t\t\t\t\t\t\t\t\t  -- Switch Inversés\n  \t\t\t\t\t fibaro:startScene(12)\n  \t\t\t\t\t -- fibaro:abort()\n  \t\t\t\telse fibaro:debug('Switch Error') \n    end    \nfibaro:sleep(180000) -- Changer de 380000 à 240000 le 16/12/2019 pour plus de réactivité\n\t--end","ui.Label1.value":"Automatique","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"---Chauffage---","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Automatique","name":"Button11","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Automatique')","buttonIcon":59,"favourite":false,"main":true}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"Manuel Fibaro","name":"Button21","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Presence')","buttonIcon":60,"favourite":false,"main":false},{"id":4,"lua":true,"waitForResponse":false,"caption":"Hors Gel","name":"Button22","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Hors_Gel')","buttonIcon":61,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":5,"lua":true,"waitForResponse":false,"caption":"STOP","name":"Button31","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'STOP')","buttonIcon":93,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}