{"name":"535 SRT321 pb (G726)","type":"virtual_device","properties":{"deviceIcon":1046,"categories":"[\"remotes\"]","currentIcon":"1054","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% events\n%% globals\nConsigne\nCONS_SALONG_324\n--]]\n\n\nlocal SRT321 = 726 -- Thermostat SRT GEN5 grange 597\nlocal Temp = 727 -- Sonde de température SRT GEN5 = 598\nlocal VD_ID = fibaro:getSelfId() --535\nlocal val = fibaro:getValue(Temp, \"value\") -- current temp\nlocal TARGET = fibaro:getValue(SRT321, \"targetLevel\") -- target temp\nlocal time = (fibaro:getValue(SRT321, \"timestamp\")) -- timestamp command reception\nlocal heure = os.date(\"%H:%M\", time)\n--local interval = (fibaro:getValue(SRT321, \"interval\"))\nlocal log =( fibaro:getValue(SRT321, \"log\"))\n\n--fibaro:call(VD_ID,'setProperty','ui.Label1.value', Cons)\n\nfibaro:debug(\"ID SRT321 \" .. SRT321)\nfibaro:debug(\"Température actuelle : \" .. val ..\"°C\")\n--fibaro:debug(\"Consigne : \" .. Consigne .. \"°C\")\nfibaro:debug(\"Consigne actuelle à \" .. TARGET .. \"°C\")\n\n--local Cons = fibaro:getGlobal(\"CONS_SALONG_324\")\n--fibaro:debug(\"Consigne demandée à \" .. Cons .. \"°C\")\n\n--if Cons == TARGET\n  --then fibaro:debug(\"On ne fait rien\")\n  --else\n-- Action reprogrammation  de la consigne du SRT321\n--fibaro:call(SRT321, \"setTargetLevel\", Cons)\n-- Affichage sur VD de la nouvelle Consigne\nfibaro:call(VD_ID,'setProperty','ui.Label1.value', TARGET)\n--fibaro:call(535,'setProperty','ui.Label1.value', Cons)\n---end\n  -- Attente\nfibaro:sleep(1000)\nTARGET2 = (fibaro:getValue(SRT321, \"targetLevel\"))\nfibaro:debug(\"Nouvelle consigne est \" .. TARGET2 .. \"°C\")\nfibaro:debug(\"commande reçue à \".. time)\nfibaro:debug(\"Horaire \"  .. heure)\n--fibaro:debug(\"Durée de \" .. interval)\nfibaro:debug(log)\nfibaro:call(VD_ID,'setProperty','ui.Label2.value', log)\n\nlocal log1 = fibaro:getValue(SRT321, \"log\")\nfibaro:debug(log1)\nfibaro:call(VD_ID,'setProperty','ui.Label2.value', log1)\n\nfibaro:sleep(1*5*60*1000) -- h,mn,s,ms\nlocal log2 = fibaro:getValue(SRT321, \"log\")\nfibaro:debug(log2)\nfibaro:call(VD_ID,'setProperty','ui.Label2.value', log2)\n\n--fibaro:abort()","ui.Label1.value":"19","ui.Label2.value":"En attente du réveil","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Hors Gel","name":"Button11","empty":false,"msg":"GET /api/callAction?deviceID=674&name=pressButton&arg1=1 HTTP/1.1\nHost:192.168.1.11\nAuthorization: Basic YnJ1dmllcmVAb3JhbmdlLmZyOjIzNTdCY2N2NzY3Nw==\n\n","buttonIcon":1054,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":false,"waitForResponse":false,"caption":"-1°C","name":"Button21","empty":false,"msg":"GET /api/callAction?deviceID=674&name=pressButton&arg1=2 HTTP/1.1\nHost:192.168.1.11\nAuthorization: Basic YnJ1dmllcmVAb3JhbmdlLmZyOjIzNTdCY2N2NzY3Nw==\n\n","buttonIcon":1048,"favourite":false,"main":false},{"id":3,"lua":false,"waitForResponse":false,"caption":"+1°C","name":"Button22","empty":false,"msg":"GET /api/callAction?deviceID=674&name=pressButton&arg1=3 HTTP/1.1\nHost:192.168.1.11\nAuthorization: Basic YnJ1dmllcmVAb3JhbmdlLmZyOjIzNTdCY2N2NzY3Nw==\n\n","buttonIcon":1048,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":false,"waitForResponse":false,"caption":"18°","name":"Button31","empty":false,"msg":"GET /api/callAction?deviceID=674&name=pressButton&arg1=4 HTTP/1.1\nHost:192.168.1.11\nAuthorization: Basic YnJ1dmllcmVAb3JhbmdlLmZyOjIzNTdCY2N2NzY3Nw==\n\n","buttonIcon":1049,"favourite":false,"main":false},{"id":5,"lua":false,"waitForResponse":false,"caption":"19°","name":"Button32","empty":false,"msg":"GET /api/callAction?deviceID=674&name=pressButton&arg1=5 HTTP/1.1\nHost:192.168.1.11\nAuthorization: Basic YnJ1dmllcmVAb3JhbmdlLmZyOjIzNTdCY2N2NzY3Nw==\n\n","buttonIcon":1052,"favourite":false,"main":false},{"id":6,"lua":false,"waitForResponse":false,"caption":"20°","name":"Button33","empty":false,"msg":"GET