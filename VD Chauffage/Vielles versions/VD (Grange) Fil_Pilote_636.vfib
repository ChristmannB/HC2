{"name":"Fil Pilote 636","type":"virtual_device","properties":{"deviceIcon":1097,"categories":"[\"climate\"]","currentIcon":"1097","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% globals\n--]]\nlocal qubino = 636\nlocal VDID = fibaro:getSelfId()\n--Mode = fibaro:getGlobalValue(\"pct\")\n\nfibaro:debug(\"Position du Qubino \" .. fibaro:getValue(qubino, \"value\"))\n\t\tif (fibaro:getGlobal('Q_PCT') == fibaro:getValue(qubino, \"value\"))\n  \t\tthen\nlocal text = \" \"\nif (fibaro:getValue(qubino,\"value\") >= \"51\") then\ntext = \"Confort\";\nelseif (fibaro:getValue(qubino,\"value\") > \"40\") then\ntext = \"Confort -1°C\";\nelseif (fibaro:getValue(qubino,\"value\") > \"30\") then\ntext = \"Confort -2°C\";\nelseif (fibaro:getValue(qubino,\"value\") > \"20\") then\ntext = \"Eco\";\nelseif (fibaro:getValue(qubino,\"value\") > \"10\") then\ntext = \"Hors gel\";\nelseif (fibaro:getValue(qubino,\"value\") < \"10\") then\ntext = \"Arrêt\";\nelse\ntext = \"Problème\";\nend\nfibaro:call(VDID, \"setProperty\", \"ui.Label1.value\", text);\n\n\t\telse\n local mode = fibaro:getGlobal('Q_PCT')\n--fibaro:setGlobal('MODE', mode)\n    fibaro:debug(\"le mode est \", mode)\nfibaro:call(qubino, \"setValue\", mode)\n--VD_ID = fibaro:selfId()\n--fibaro:call(VDID,'setProperty','ui.Label1.value', \"Le prourcentage est de : \".. mode)\nlocal text = \" \"\nif (fibaro:getValue(qubino,\"value\") >= \"51\") then\ntext = \"Confort\";\nelseif (fibaro:getValue(qubino,\"value\") > \"40\") then\ntext = \"Confort -1°C\";\nelseif (fibaro:getValue(qubino,\"value\") > \"30\") then\ntext = \"Confort -2°C\";\nelseif (fibaro:getValue(qubino,\"value\") > \"20\") then\ntext = \"Eco\";\nelseif (fibaro:getValue(qubino,\"value\") > \"10\") then\ntext = \"Hors gel\";\nelseif (fibaro:getValue(qubino,\"value\") < \"10\") then\ntext = \"Arrêt\";\nelse\ntext = \"Problème\";\nend\nfibaro:call(VDID, \"setProperty\", \"ui.Label1.value\", text);\n\t\tend\n--fibaro:sleep(1*60*1000)\n\n--fibaro:abort()","ui.Label1.value":"Hors gel","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Le mode est :","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Arrêt","name":"Button11","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 0)\n--fibaro:setGlobal(\"pct\", 0)\n--fibaro:debug(\"Pourcentage à \" .. pct)\n--fibaro:getGlobalValue(pct)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1093,"favourite":false,"main":false},{"id":3,"lua":true,"waitForResponse":false,"caption":"Confort","name":"Button12","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 99)\n\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1094,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":true,"waitForResponse":false,"caption":"Hors gel","name":"Button21","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 15)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1091,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"Confort -2","name":"Button22","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 40)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1095,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"Confort -1","name":"Button23","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 50)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1096,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":7,"lua":true,"waitForResponse":false,"caption":"Eco","name":"Button31","empty":false,"msg":"fibaro:setGlobal('Q_PCT', 26)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1092,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}