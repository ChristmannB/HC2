{"name":"753 Rad.Pilote Ch1er","type":"virtual_device","properties":{"deviceIcon":1097,"categories":"[\"remotes\"]","currentIcon":"1097","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% globals\n--]]\nlocal vesion = 1.2 -- utilisation du Mode_Maison pour contrôler le VD\nlocal qubino1 = 613\nlocal qubino2 = 619\nlocal VDID = fibaro:getSelfId()\nlocal vdChauffage=fibaro:getValue(781,\"ui.Label3.value\")\nlocal modeMaison=fibaro:getGlobal(\"Mode_Maison\")\nfibaro:debug(\"Chauffage en mode \" .. modeMaison .. \" et état du VD chauffage est \" ..vdChauffage) \n  if modeMaison==\"Presence\" then\n        fibaro:call(VDID,\"setProperty\",\"ui.Label2.value\",\"Actif\")\n    \n    --Mode = fibaro:getGlobalValue(\"pct\")\n    fibaro:debug(\"Position du Qubino1 \" .. fibaro:getValue(qubino1, \"value\"))\n    fibaro:debug(\"Position du Qubino2 \" .. fibaro:getValue(qubino2, \"value\"))\n            if (fibaro:getGlobal('Q_PCT2') == fibaro:getValue(qubino1, \"value\")) and (fibaro:getGlobal('Q_PCT2') == fibaro:getValue(qubino2, \"value\"))\n            then\n            local text = \" \" \n              if (fibaro:getValue(qubino2,\"value\") >= \"51\") then\n              text = \"Confort\";\n              elseif (fibaro:getValue(qubino2,\"value\") > \"40\") then\n              text = \"Confort -1°C\";\n              elseif (fibaro:getValue(qubino2,\"value\") > \"30\") then\n              text = \"Confort -2°C\";\n              elseif (fibaro:getValue(qubino2,\"value\") > \"20\") then\n              text = \"Eco\";\n              elseif (fibaro:getValue(qubino2,\"value\") > \"10\") then\n              text = \"Hors gel\";\n              elseif (fibaro:getValue(qubino2,\"value\") < \"10\") then\n              text = \"Arrêt\";\n              else\n              text = \"Problème - les 2 qubino n'ont pas le même réglage\";\n                  \n              end\n    \t\tfibaro:call(VDID, \"setProperty\", \"ui.Label1.value\", text);\n    \n            else\n     \t\tlocal mode = fibaro:getGlobal('Q_PCT2')\n    \t\t--fibaro:setGlobal('MODE', mode)\n        \tfibaro:debug(\"le Mode est \", mode)\n    \t\tfibaro:call(qubino1, \"setValue\", mode)\n            fibaro:call(qubino2, \"setValue\", mode)\n            --VD_ID = fibaro:selfId()\n            --fibaro:call(VDID,'setProperty','ui.Label1.value', \"Le prourcentage est de : \".. mode)\n            local text = \" \"\n          if (fibaro:getValue(qubino1,\"value\") >= \"51\") then\n          text = \"Confort\";\n          elseif (fibaro:getValue(qubino1,\"value\") > \"40\") then\n          text = \"Confort -1°C\";\n          elseif (fibaro:getValue(qubino1,\"value\") > \"30\") then\n          text = \"Confort -2°C\";\n          elseif (fibaro:getValue(qubino1,\"value\") > \"20\") then\n          text = \"Eco\";\n          elseif (fibaro:getValue(qubino1,\"value\") > \"10\") then\n          text = \"Hors gel\";\n          elseif (fibaro:getValue(qubino1,\"value\") < \"10\") then\n          text = \"Arrêt\";\n          else\n          text = \"Problème\";\n          end\n    \tfibaro:call(VDID, \"setProperty\", \"ui.Label1.value\", text);\n\t\t\tend\n--fibaro:sleep(1*60*1000)\n  else\n  \tfibaro:debug(\"Le VD est désactivé car le mode de chauffage n'est pas Presence\")\n\tfibaro:call(VDID,\"setProperty\",\"ui.Label2.value\",\"VD désactivé\")\n  end\n","ui.Label1.value":"Arrêt","ui.Label2.value":"VD désactivé","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Le mode est :","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Arrêt","name":"Button11","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 0)\n--fibaro:setGlobal(\"pct\", 0)\n--fibaro:debug(\"Pourcentage à \" .. pct)\n--fibaro:getGlobalValue(pct)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1093,"favourite":false,"main":false},{"id":3,"lua":true,"waitForResponse":false,"caption":"Confort","name":"Button12","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 99)\n\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1094,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":true,"waitForResponse":false,"caption":"Hors gel","name":"Button21","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 15)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1091,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"Confort -2","name":"Button22","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 35)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1095,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"Confort -1","name":"Button23","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 45)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1096,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":7,"lua":true,"waitForResponse":false,"caption":"Eco","name":"Button31","empty":false,"msg":"fibaro:setGlobal('Q_PCT2', 25)\n--fibaro:call(636, \"setValue\", Q_PCT)","buttonIcon":1092,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":8,"lua":false,"waitForResponse":false,"caption":"Etat du VD","name":"Label2","favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}