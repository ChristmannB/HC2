{"name":"677 Thrmst C RDC 601","type":"virtual_device","properties":{"deviceIcon":1082,"categories":"[\"climate\"]","currentIcon":"1082","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% events\n%% globals\nConsigne_G\nSRT123_ID\n--]]\n\nlocal VDID = fibaro:getSelfId()\n--définition du SRT à commander dans la variable globale SRT123_ID\nlocal SRT321 = 601 --\t\tfibaro:setGlobal(\"SRT123_ID_ChRDC\",601) \nlocal version = 1.2 -- UI correction (Label2)\nlocal Temp = tonumber(SRT321)+1 -- Sonde de température couplée au SRTGEN5\n\t\tfibaro:debug(\"le SRT à piloter a pour ID : \".. SRT321 ..\"et la sonde de T° est \".. Temp)\n\n--\t\tfibaro:debug(\"Ce VD SRT321_\" .. SRT123_ID ..\" a pour ID :  \" .. VDID )\nlocal ROOMID = fibaro:getRoomID(VDID)\n--\t\tfibaro:setGlobal(\"piece\", ROOMID)\n\t\tfibaro:debug(\"La pièce de ce VD a pour ID :  \" .. ROOMID )\nlocal NomPiece = fibaro:getRoomName(ROOMID)\n\t\tfibaro:debug(\"La pièce de ce VD a pour nom :  \" ..  NomPiece )\n--GlobalCons = \"Consigne\".. ROOMID\nlocal val = (fibaro:getValue(Temp, \"value\")) -- current temp\n\tfibaro:debug(\"Température actuelle : \" .. val ..\"°C\")\nfibaro:call(VDID, 'setProperty','ui.Label3.value', val .. \"°C\")\nlocal setp = fibaro:getValue(SRT321, \"value\") -- Consigne de T° lue\n\tfibaro:debug(\"Consigne actuelle à \" .. setp .. \"°C\")\nlocal Cons = fibaro:getGlobal(\"Consigne25\") -- consigne demandée\n\tfibaro:debug(\"Nouvelle consigne : \" .. Cons .. \"°C\")\nfibaro:call(VDID,'setProperty','ui.Label1.value', Cons .. \"°C\")  -- ajout  .. \"°C\" -- Affichage de la nouvelle consigne\n\nif (Cons == setp)\n  then\n  fibaro:debug(\"On ne fait rien\")\n  else\n--local interval = (fibaro:getValue(SRT123_ID, \"interval\"))\n\n--fibaro:call(VDID,'setProperty','ui.Label1.value', Cons .. \"°C\")  -- ajout  .. \"°C\" -- Affichage de la nouvelle consigne\n\n--fibaro:call(597, \"value\", Cons) \n--  fibaro:setvalue(597, Cons) -- envoi de la nouvelle consigne au SRT\n fibaro:call(SRT321, \"setThermostatSetpoint\", Cons, Cons)\n  --fibaro:call(597, \"setPoint\", cons)\n fibaro:call(SRT321, \"setTargetLevel\", Cons)\n  \nfibaro:debug(\"Nouvelle consigne à \" .. Cons .. \"°C - Commande envoyée\" )\n\n  fibaro:debug(\"fin\")\n--local log =( fibaro:getValue(SRT123_ID, \"log\"))\nlocal Log = fibaro:getValue(SRT321, \"log\") -- EX 601\nfibaro:debug(\"Etat : \" .. Log)\nfibaro:call(VDID,'setProperty','ui.Label2.value', Log)  --\n  --\n  end\n--local log =( fibaro:getValue(597, \"log\"))\n--fibaro:debug(\"Etat : \" .. log)\nfibaro:debug(\"Attente de 30 secondes\")\nfibaro:sleep(30*1000)\n--Log = fibaro:getValue(SRT123iD, \"log\")\n--fibaro:call(VDID,'setProperty','ui.Label2.value', Log)  --\n\nlocal mode = fibaro:getGlobal(\"SRT2\")\nif mode == \"Automatique\"\n  then fibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle par panneau de Chauffage\")\n\telse fibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\n\t end\n fibaro:debug(\"Nous sommes en mode \" .. mode)\n\n\n","ui.Label1.value":"10°C","ui.Label2.value":"Contrôle par panneau de Chauffage","ui.Label3.value":"20.6°C","visible":"true","rows":[{"type":"button","elements":[{"id":1,"lua":true,"waitForResponse":false,"caption":"Hors Gel","name":"Button11","empty":false,"msg":"local HG = fibaro:getGlobal(\"H_G\")\nfibaro:setGlobal(\"Consigne25\", HG)\nfibaro:log(\"Consigne mise à \"..HG..\"°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")\nlocal selfId = fibaro:getSelfId()\nlocal currentZone = \"\"\nlocal currentPanelName = \"\"\nlocal currentPanelId = 0\nlocal previousZone = \"\"\nlocal previousPanelName = \"\"\nlocal previousPanelId = 0\nlocal panelOverrideTemp = 0\nlocal panelEndTimestamp = 0\nlocal panelRooms = {}\nlocal currentTemps = \"\"\nlocal tempTimeLabel = \"\"\nlocal tempUnit = \"\"\nlocal currentTimestamp = os.time()\n\n","buttonIcon":1105,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"- 1°C","name":"Button21","empty":false,"msg":"local SRT321 = 601\nfibaro:setGlobal(\"Consigne25\",  tonumber (fibaro:getValue(SRT321, \"targetLevel\"))-1)\nfibaro:log(\"Consigne diminuée de 1°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")","buttonIcon":1090,"favourite":false,"main":false},{"id":3,"lua":true,"waitForResponse":false,"caption":"+ 1°C","name":"Button22","empty":false,"msg":"local SRT321 = 601\nfibaro:setGlobal(\"Consigne25\",  tonumber (fibaro:getValue(SRT321, \"targetLevel\"))+1)\nfibaro:log(\"Consigne augmentée de 1°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")","buttonIcon":1090,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":4,"lua":true,"waitForResponse":false,"caption":"18°","name":"Button31","empty":false,"msg":"fibaro:setGlobal(\"Consigne25\", 18)\nfibaro:log(\"Consigne mise à 18°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")\n","buttonIcon":1085,"favourite":false,"main":false},{"id":5,"lua":true,"waitForResponse":false,"caption":"19°","name":"Button32","empty":false,"msg":"fibaro:setGlobal(\"Consigne25\", 19)\nfibaro:log(\"Consigne mise à 19°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")\n","buttonIcon":1086,"favourite":false,"main":false},{"id":6,"lua":true,"waitForResponse":false,"caption":"20°","name":"Button33","empty":false,"msg":"fibaro:setGlobal(\"Consigne25\", 20)\nfibaro:log(\"Consigne mise à 20°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")\n","buttonIcon":1087,"favourite":false,"main":false},{"id":7,"lua":true,"waitForResponse":false,"caption":"21°","name":"Button34","empty":false,"msg":"fibaro:setGlobal(\"Consigne25\", 21)\nfibaro:log(\"Consigne mise à 21°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")\nfibaro:setGlobal(\"SRT2\",\"Manuel\")\n","buttonIcon":1088,"favourite":false,"main":false},{"id":8,"lua":true,"waitForResponse":false,"caption":"22°","name":"Button35","empty":false,"msg":"fibaro:setGlobal(\"Consigne25\", 22)\nfibaro:log(\"Consigne mise à 22°C\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle manuel\")  --\nfibaro:setGlobal(\"SRT2\",\"Manuel\")","buttonIcon":1089,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":9,"lua":true,"waitForResponse":false,"caption":"Panneau de Chauffage","name":"Button41","empty":false,"msg":"fibaro:log(\"Contrôle automatique par panneau de chauffage\")\nlocal VDID = fibaro:getSelfId()\nfibaro:call(VDID,'setProperty','ui.Label2.value', \"Contrôle par panneau de chauffage\")  --\nfibaro:setGlobal(\"SRT2\",\"Automatique\")","buttonIcon":1104,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":10,"lua":false,"waitForResponse":false,"caption":"Consigne en °C ","name":"Label1","favourite":false,"main":true}]},{"type":"label","elements":[{"id":11,"lua":false,"waitForResponse":false,"caption":"Etat ","name":"Label2","favourite":false,"main":false}]},{"type":"label","elements":[{"id":12,"lua":false,"waitForResponse":false,"caption":"T° actuelle","name":"Label3","favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}