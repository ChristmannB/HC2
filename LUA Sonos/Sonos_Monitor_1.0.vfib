{"name":"Sonos Monitor 1.0","type":"virtual_device","properties":{"deviceIcon":0,"currentIcon":"0","log":"monitor running","logTemp":"TxtGreen","mainLoop":"\n--[[\nSonos Monitor 1.0 by AutoFrank (Oct 4th 2017) \n\nThis VD monitorsd and displays status of osonos devices (OFFLINE, STATE (PLAYING, STOPPED, ETC & VOLUME) \n** YOU NEED TO BE USING THE SONOS-HTTP-API FOR THIS VD TO WORK **\n** YOU NEED TO BE USING THE WWWAPI MONITOR FOR THIS VD TO WORK **\nNotification options for when a player goes offline and back online and is configurable (Smart Message Hub or HC2 email) \nOne Alert will be received when player goes offline and another when it comes back online\nOnline/Offline status is captured in global table (SonosTable) that can be used by other scenes and VD's\n\n==VERSION==\n1.0     - Sonos Player Monitor\n\n==INSTALLATION==\nSTEPS   - Import the Sonos Monitor 1.0 virtual device, add IP and Port of sonos API on VD General Tab\n\t\t- Status herading and one sonos player label (Label1) has been created as part of the VD\n\t\t- Add one label per extra sonos payers you have using the default label naming (Lable2, Lable3, Label4, etc)\n\t\t- Populate the sonos table with Player (what player is called in sonos) and Room (room name in HC2)\n        - Run VD with updateData  = \"true\" to populate the device table. Open debug window and you shold see\n\t\t- \"Sonos Table successfully Updated\" followed by which sonos players are online\n        - Run VD with updateData  = \"false\" to operate in normal mode\n--]]\n\n-- Local variable declaration\ndevice \t\t\t= fibaro:getSelfId()\nlocal ipaddress = fibaro:getValue(device, \"IPAddress\");\nlocal port \t\t= fibaro:getValue(device, \"TCPPort\");\nsonos \t\t\t= Net.FHttp(ipaddress, port);\nlocal jT \t\t= json.decode(fibaro:getGlobalValue(\"HomeTable\"))\nlocal z = 0\n\n-- ** USER CONFIGUATION - NOTIFICATION & UPDATE OPTIONS **\nlocal updateFreq  = \"250\"    -- Set the frequency (milliseconds) that you want to vd to poll the LAN per device\nlocal updateData  = \"false\" \t -- Set to true to update the data in the table. ** SET BACK TO FALSE ONCE COMPLETE **\nlocal SMsgH  \t  = \"true\"   -- Set to true is you use my smart message hub. Setting to False uses HC2 email \nlocal Debug  \t  = \"true\"   -- Set to true to see additional feedback in debug screen\n--if fibaro:getGlobalValue(\"automationMode\") == \"0\" then fibaro:abort() end -- Uncomment if you use an automation disabler\n\n\n-- ** USER CONFIGUATION - SONOS DEVICES **\nfunction populateTable()\nplayers = {\n\t{room = \"Landing\", \t\t\tplayer = \"Landing\", \t\tisOnline=0, isPlaying=0 },\n\t{room = \"Twins bedroom\", \tplayer = \"Bed_LE\", \t\t\tisOnline=0, isPlaying=0 },\n\t{room = \"Frank bedroom\", \tplayer = \"Bed_Frank\", \t\tisOnline=0, isPlaying=0 },\n\t{room = \"Guest bedroom\", \tplayer = \"Bed_Guests\", \t\tisOnline=0, isPlaying=0 },\n\t{room = \"Master bedroom\", \tplayer = \"Bed_MasterL\", \tisOnline=0, isPlaying=0 },\n\n}\n  \n  local jTable = json.encode(players)\n  fibaro:setGlobal(\"SonosTable\", jTable)\n  local jSo = json.decode(fibaro:getGlobalValue(\"SonosTable\"))\n  if jSo[1].player == \"\" then\n    fibaro:debug(\"Sonos table did NOT get created successfully. Please debug\")\n  else\n    fibaro:debug(\"Sonos table successfully updated\")\n  \n\tfibaro:sleep(2000)\n\tfibaro:debug(\"Checking with players are online..\")\n\tfibaro:sleep(2000)\n  \n\tfor k,v in pairs(jSo) do\n\t\tlocal sPlayer = jSo[k].player\n\t\tresponse, error = sonos:GET(\"/\"..sPlayer..\"/state\")\n\t\tif error == \"200\" then\n\t\t\tfibaro:debug(\"--> \"..sPlayer..\": Online\")\n\t\t\tjSo[k].isOnline = 1\n\t\telse\n\t\t\tfibaro:debug(\"--> \"..sPlayer..\": OFFLINE\")\n\t\t\tjSo[k].isOnline = 0\n\t\tend\n\t\tjSonosTable = json.encode(jSo)\n\t\tfibaro:setGlobal(\"SonosTable\", jSonosTable)\n\t\tfibaro:sleep(300)\n\tend\n  \n  end\n  \nend\n\nfunction updateTable()\n  if fibaro:getGlobalValue(\"SonosTable\") == nil then\n    local HC2 = Net.FHttp(\"127.0.0.1\",11111);\n    local response ,status, err = HC2:POST('/api/globalVariables','{\"name\":\"SonosTable\",\"value\":\"\"}');\n    if (tonumber(status) == 200 and tonumber(err) == 0) then\n      fibaro:log(\"SonosTable created\");\n    end\n  else\n  end\n  populateTable()\nend\n\n\nfunction checkAPI()\n\t-- notify and abort vd Main loop if sonosAPI is offline\n\tlocal jN = json.decode(fibaro:getGlobalValue(\"WWWAPITable\"))\n\tfor i = 1, #jN do\n\t  if jN[i].device == \"sonosAPI\" then\n\t\tif jN[i].online == 0 then\n\t\t\tfibaro:call(device,\"setProperty\",\"ui.activeZones.value\", \"Sonos API is offline\"); \n\t\t\tmessage = \"Sonos VD not running as Sonos API is offline\"\n\t\t\tmtitle = \"Music Zones\"\n\t\t\tif SMsgH == \"true\" then\n\t\t\t\tfibaro:startScene(jT.scene.SMsgH, {message, \"pushover\", \"\", mtitle})\n\t\t\telse\n\t\t\t\tfibaro:call(2, \"sendEmail\", mtitle, message)\n\t\t\tend\n\t\t\tfibaro:debug(\"Sonos API is offline\")\n\t\t\tfibaro:abort()\n\t\tend\n\t  end\n\tend\nend\n\n-- MAIN CODE\nif updateData == \"true\" then \n\tupdateTable()\n\treturn\nelse\n\tlocal jS = json.decode(fibaro:getGlobalValue(\"SonosTable\"))\n\tif jS[1].room == \"\" then\n\t\tfibaro:debug(\"Sonos Table not populated\")\n\telse\n\tcheckAPI()\n\tfor k,v in pairs(jS) do\n\t\tlocal sPlayer = jS[k].player\n\t\tlocal sRoom = jS[k].room\n\t\t\t\t\t\t\t\n\t\tresponse, error = sonos:GET(\"/\"..sPlayer..\"/state\")\n\t\tlocal zError = error\n\t\tif error == \"200\" then\n\t\t\tjAPItable = json.decode(response);\n\t\t\tif jAPItable.playbackState ~= nil or jAPItable.playbackState ~= \"\" then\n\t\t\t  summary = jAPItable.playbackState..\", \"..jAPItable.volume..\"%\"\n\t\t\t  fibaro:call(device,\"setProperty\",\"ui.Label\"..k..\".value\",summary);\n\t\t\t  if jAPItable.playbackState == \"PLAYING\" then \n\t\t\t\t\tz = z + 1 \n\t\t\t\t\tjS[k].isPlaying = 1\n\t\t\t\t\tif jS[k].isOnline == 0 then\n\t\t\t\t\t\tmessage = jS[k].player..\" Music zone is back online\"\n\t\t\t\t\t\tmtitle = \"Music Zone Alert\"\n\t\t\t\t\t\tif SMsgH == \"true\" then\n\t\t\t\t\t\t\tfibaro:startScene(jT.scene.SMsgH, {message, \"pushover\", \"\", mtitle})\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tfibaro:call(2, \"sendEmail\", mtitle, message)\n\t\t\t\t\t\tend\n\t\t\t\t\t\tjS[k].isOnline = 1\n\t\t\t\t\tend\n\t\t\t\t\tjSonosTable = json.encode(jS)\n\t\t\t\t\tfibaro:setGlobal(\"SonosTable\", jSonosTable)\n\t\t\t  else\n\t\t\t\t  jS[k].isPlaying = 0\n\t\t\t\t  jSonosTable = json.encode(jS)\n\t\t\t\t  fibaro:setGlobal(\"SonosTable\", jSonosTable)\n\t\t\t  end\n\t\t\tend\n\t\t\tif Debug then fibaro:debug(zError..\", \"..sPlayer..\", \"..sRoom..\", \"..summary) end\n\t\telse\n\t\t\tfibaro:call(device,\"setProperty\",\"ui.Label\"..i..\".value\", \"OFFLINE\")\n\t\t\tfibaro:debug(zones[k][\"player\"]..\" zone is OFFLINE\")\n\t\t\tif jS[k].isOnline == 1 then\n\t\t\tmessage = jS[k].player..\" Music zone is offline\"\n\t\t\tmtitle = \"Music Zone Alert\"\n\t\t\t\tif SMsgH == \"true\" then\n\t\t\t\t\tfibaro:startScene(jT.scene.SMsgH, {message, \"pushover\", \"\", mtitle})\n\t\t\t\telse\n\t\t\t\t\tfibaro:call(2, \"sendEmail\", mtitle, message)\n\t\t\t\tend\n\t\t\tend\n\t\t\tjS[k].isOnline = 0\n\t\t\tjSonosTable = json.encode(jS)\n\t\t\tfibaro:setGlobal(\"SonosTable\", jSonosTable)\n\t\t\tif Debug then fibaro:debug(zError..\", \"..sPlayer..\", \"..sRoom..\", OFFLINE\") end\n\t\tend\n\t\t\t\n\tend\n\t\t\n\t\tfibaro:setGlobal(\"ActiveMusicZones\", z);\n\t\tif z == 0 then zStatus = \"No music zones active\" end\n\t\tif z == 1 then zStatus = z..\" music zone active\" end\n\t\tif z >  1 then zStatus = z..\" music zones active\" end\n\t\tfibaro:call(device,\"setProperty\",\"ui.activeZones.value\",zStatus);\n\t\t\n\t\tfibaro:log(\"monitor running\")\n\t\t\n\tend\nend\n\t\n\t\n\t\n--[[\n==NOTICE==\nDistribution and use of this source code, with or without modification, \nis permitted provided this notice is distributed with it. The Software Is \nProvided \"As Is\", Without Warranty Of Any Kind, Expressed Or Implied, \nIncluding But Not Limited To The Warranties Of Merchantability, Fitness \nFor A Particular Purpose And Noninfringement. In No Event Shall The Authors \nOr Copyright Holders Be Liable For Any Claim, Damages Or Other Liability, \nWhether In An Action Of Contract, Tort Or Otherwise, Arising From, Out Of Or\nIn Connection With The Software Or The Use Or Other Dealings In The Software.\n--]]\n","ui.Label1.value":"STOPPED, 9%","ui.Label2.value":"PLAYING, 11%","ui.Label3.value":"PLAYING, 11%","ui.Label4.value":"STOPPED, 12%","ui.Label5.value":"STOPPED, 7%","ui.activeZones.value":"2 music zones active","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Status","name":"activeZones","favourite":true,"main":true}]},{"type":"label","elements":[{"id":2,"lua":false,"waitForResponse":false,"caption":"Landing","name":"Label1","favourite":false,"main":false}]},{"type":"label","elements":[{"id":3,"lua":false,"waitForResponse":false,"caption":"Twins Bedroom","name":"Label2","favourite":false,"main":false}]},{"type":"label","elements":[{"id":4,"lua":false,"waitForResponse":false,"caption":"Frank Bedroom","name":"Label3","favourite":false,"main":false}]},{"type":"label","elements":[{"id":5,"lua":false,"waitForResponse":false,"caption":"Guest Bedroom","name":"Label4","favourite":false,"main":false}]},{"type":"label","elements":[{"id":6,"lua":false,"waitForResponse":false,"caption":"Master Bedroom","name":"Label5","favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}