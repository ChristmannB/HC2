d\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);\n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n--- Radio Station ---\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nplayRadio= function(station, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-rincon-mp3radio://http://wdr-1live-live.cast.addradio.de/wdr/1live/live/mp3/128/stream.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n    setVolume(volume);\n    ttsVolumeIsDifferent = true; \n  end\n \n  play();\n \n  end);\nend\n\n-- Globale Variabel abfragen & verwenden\nif fibaro:getGlobalValue(\"Sonos_Radio\") == \"\" then\n  playRadio(\"wdr-1live-live.cast.addradio.de/wdr/1live/live/mp3/128/stream.mp3\", nil);\nelse\n  playRadio(fibaro:getGlobalValue(\"Sonos_Radio\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Radio läuft...\"); --Status Anzeige im VD Interface\n--fibaro:call(selfId, \"setProperty\", \"ui.btnVolume.value\", lastVolume); --Volume Anzeige im VD Interface  \n--fibaro:call(selfId, \"setSlider\", \"ui.btnVolume.value\", lastVolume)","buttonIcon":0,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":11,"lua":true,"waitForResponse":false,"caption":"you FM","name":"btnyouFM","empty":false,"msg":"selfId = fibaro:getSelfId();    \nip = fibaro:get(selfId, 'IPAddress');\nport = fibaro:get(selfId, 'TCPPort');\ncurrentTransportState = \"\";\nlastTransportState = \"\";\ncurrentVolume = 0;\nlastVolume = 0;\nttsVolumeIsDifferent = false;\n\nurlencode = function(str)\n  if (str) then\n    str = string.gsub (str, \"\\n\", \"\\r\\n\");\n    str = string.gsub (str, \"([^%w ])\", function (c) return string.format (\"%%%02X\", string.byte(c)) end);\n    str = string.gsub (str, \" \", \"+\");\n  end\n  return str;\nend\n\ncreateRequestBody = function(action, schema, data)\n  return string.format(\"<u:%s xmlns:u=\\\"%s\\\">%s</u:%s>\", action, schema, data, action);\nend\n\nreponseCallback = function(fnc, args)\n  if (fnc == nil) then\n    return nil;\n  end\n  return fnc(args);\nend\n\ncreateSocket = function()\n    -- Check IP and PORT before\n  if (ip == nil or port == nil) then\n    fibaro:debug(\"You must configure IPAddress and TCPPort first\");\n    return;\n  end\n  local socket;\n  local status, err = pcall(function() \n      socket = Net.FTcpSocket(ip, port);\n      socket:setReadTimeout(1000);\n    end);  \n  if (status ~= nil and status ~= true) then\n    fibaro:debug(\"socket status: \" .. tostring(status or ''));\n  end  \n  if (err ~= nil) then\n    fibaro:debug(\"socket err: \" .. tostring(err or ''));\n    return;\n  end\n  return socket;\nend\n\ndisposeSocket = function(socket)\n  if (socket ~= nil) then\n    socket:disconnect();\n    socket = nil;\n    return true;\n  end\n  return false;\nend\n\nsendSoapMessage = function(url, service, action, args, callback, retry)\n    \n  local socket = createSocket();\n  if (socket == nil) then\n    return;\n  end\n  retry = retry or 0\n  -- prepare data\n  local url = \"POST \" .. url .. \" HTTP/1.1\";\n  fibaro:debug(ip)\n  local so1=\"HOST: \".. ip ..\":1400\"\n  local soapaction = \"SOAPACTION: \\\"\" .. service .. \"#\" .. action.name .. \"\\\"\";\n  local body = createRequestBody(action.name, action.service, tostring(args or \"\"));\n  local envelope = \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?><s:Envelope xmlns:s=\\\"http://schemas.xmlsoap.org/soap/envelope/\\\" s:encodingStyle=\\\"http://schemas.xmlsoap.org/soap/encoding/\\\"><s:Body>\" .. body .. \"</s:Body></s:Envelope>\";\n  local ctl = \"Content-Length: \" .. string.len(envelope);\n  local payload = url .. \"\\r\\n\" .. so1 .. \"\\r\\n\" .. ctl .. \"\\r\\n\" .. soapaction .. \"\\r\\n\" .. \"\\r\\n\" .. envelope;\n  -- write data\n  local bytes, errorcode = socket:write(payload);\n  if (errorcode == 0) then\n    local state, errorcode = socket:read();\n    if (errorcode == 0) then\n      if (string.len(state or \"\") > 0) then\n        -- callback\n        if (callback ~= nil) then\n          reponseCallback(callback, state);\n        end\n        -- dispose ...\n        disposeSocket(socket);\n        return true;\n      else\n        fibaro:debug(\"Error: Invalid response. response length: \" .. string.len(state or \"\"));\n      end\n    else      \n      if (retry < 5) then\n        fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n        return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n      else\n        fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n      end\n    end\n  elseif (errorcode == 2) then\n    fibaro:debug(\"Error: You must check your IP and PORT settings.\");\n  else\n    if (retry < 5) then\n      fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n      return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n    else\n      fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n    end\n  end  \n  -- dispose ...\n  disposeSocket(socket);\n  -- default response\n  return false;\nend\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);\n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n--- Radio Station ---\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nplayRadio= function(station, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-rincon-mp3radio://http://addrad.io/4WRF9d</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n    setVolume(volume);\n    ttsVolumeIsDifferent = true; \n  end\n \n  play();\n \n  end);\nend\n\n-- Globale Variabel abfragen & verwenden\nif fibaro:getGlobalValue(\"Sonos_Radio\") == \"\" then\n  playRadio(\"addrad.io/4WRF9d\", nil);\nelse\n  playRadio(fibaro:getGlobalValue(\"Sonos_Radio\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Radio läuft...\"); --Status Anzeige im VD Interface\n--fibaro:call(selfId, \"setProperty\", \"ui.btnVolume.value\", lastVolume); --Volume Anzeige im VD Interface  \n--fibaro:call(selfId, \"setSlider\", \"ui.btnVolume.value\", lastVolume)\n","buttonIcon":0,"favourite":false,"main":false},{"id":12,"lua":true,"waitForResponse":false,"caption":" SSClassic","name":"btnplanetRadio","empty":false,"msg":"selfId = fibaro:getSelfId();    \nip = fibaro:get(selfId, 'IPAddress');\nport = fibaro:get(selfId, 'TCPPort');\ncurrentTransportState = \"\";\nlastTransportState = \"\";\ncurrentVolume = 0;\nlastVolume = 0;\nttsVolumeIsDifferent = false;\n\nurlencode = function(str)\n  if (str) then\n    str = string.gsub (str, \"\\n\", \"\\r\\n\");\n    str = string.gsub (str, \"([^%w ])\", function (c) return string.format (\"%%%02X\", string.byte(c)) end);\n    str = string.gsub (str, \" \", \"+\");\n  end\n  return str;\nend\n\ncreateRequestBody = function(action, schema, data)\n  return string.format(\"<u:%s xmlns:u=\\\"%s\\\">%s</u:%s>\", action, schema, data, action);\nend\n\nreponseCallback = function(fnc, args)\n  if (fnc == nil) then\n    return nil;\n  end\n  return fnc(args);\nend\n\ncreateSocket = function()\n    -- Check IP and PORT before\n  if (ip == nil or port == nil) then\n    fibaro:debug(\"You must configure IPAddress and TCPPort first\");\n    return;\n  end\n  local socket;\n  local status, err = pcall(function() \n      socket = Net.FTcpSocket(ip, port);\n      socket:setReadTimeout(1000);\n    end);  \n  if (status ~= nil and status ~= true) then\n    fibaro:debug(\"socket status: \" .. tostring(status or ''));\n  end  \n  if (err ~= nil) then\n    fibaro:debug(\"socket err: \" .. tostring(err or ''));\n    return;\n  end\n  return socket;\nend\n\ndisposeSocket = function(socket)\n  if (socket ~= nil) then\n    socket:disconnect();\n    socket = nil;\n    return true;\n  end\n  return false;\nend\n\nsendSoapMessage = function(url, service, action, args, callback, retry)\n    \n  local socket = createSocket();\n  if (socket == nil) then\n    return;\n  end\n  retry = retry or 0\n  -- prepare data\n  local url = \"POST \" .. url .. \" HTTP/1.1\";\n  fibaro:debug(ip)\n  local so1=\"HOST: \".. ip ..\":1400\"\n  local soapaction = \"SOAPACTION: \\\"\" .. service .. \"#\" .. action.name .. \"\\\"\";\n  local body = createRequestBody(action.name, action.service, tostring(args or \"\"));\n  local envelope = \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?><s:Envelope xmlns:s=\\\"http://schemas.xmlsoap.org/soap/envelope/\\\" s:encodingStyle=\\\"http://schemas.xmlsoap.org/soap/encoding/\\\"><s:Body>\" .. body .. \"</s:Body></s:Envelope>\";\n  local ctl = \"Content-Length: \" .. string.len(envelope);\n  local payload = url .. \"\\r\\n\" .. so1 .. \"\\r\\n\" .. ctl .. \"\\r\\n\" .. soapaction .. \"\\r\\n\" .. \"\\r\\n\" .. envelope;\n  -- write data\n  local bytes, errorcode = socket:write(payload);\n  if (errorcode == 0) then\n    local state, errorcode = socket:read();\n    if (errorcode == 0) then\n      if (string.len(state or \"\") > 0) then\n        -- callback\n        if (callback ~= nil) then\n          reponseCallback(callback, state);\n        end\n        -- dispose ...\n        disposeSocket(socket);\n        return true;\n      else\n        fibaro:debug(\"Error: Invalid response. response length: \" .. string.len(state or \"\"));\n      end\n    else      \n      if (retry < 5) then\n        fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n        return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n      else\n        fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n      end\n    end\n  elseif (errorcode == 2) then\n    fibaro:debug(\"Error: You must check your IP and PORT settings.\");\n  else\n    if (retry < 5) then\n      fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n      return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n    else\n      fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n    end\n  end  \n  -- dispose ...\n  disposeSocket(socket);\n  -- default response\n  return false;\nend\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);\n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n--- Radio Station ---\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nplayRadio= function(station, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-rincon-mp3radio://http://mp3.planetradio.de/planetradio/hqlivestream.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n    setVolume(volume);\n    ttsVolumeIsDifferent = true; \n  end\n \n  play();\n \n  end);\nend\n\n-- Globale Variabel abfragen & verwenden\nif fibaro:getGlobalValue(\"Sonos_Radio\") == \"\" then\n  playRadio(\"mp3.planetradio.de/planetradio/hqlivestream.mp3\", nil);\nelse\n  playRadio(fibaro:getGlobalValue(\"Sonos_Radio\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Radio läuft...\"); --Status Anzeige im VD Interface\n--fibaro:call(selfId, \"setProperty\", \"ui.btnVolume.value\", lastVolume); --Volume Anzeige im VD Interface  \n--fibaro:call(selfId, \"setSlider\", \"ui.btnVolume.value\", lastVolume)","buttonIcon":1010,"favourite":false,"main":false},{"id":13,"lua":true,"waitForResponse":false,"caption":"jam FM","name":"btnjamFM","empty":false,"msg":"selfId = fibaro:getSelfId();    \nip = fibaro:get(selfId, 'IPAddress');\nport = fibaro:get(selfId, 'TCPPort');\ncurrentTransportState = \"\";\nlastTransportState = \"\";\ncurrentVolume = 0;\nlastVolume = 0;\nttsVolumeIsDifferent = false;\n\nurlencode = function(str)\n  if (str) then\n    str = string.gsub (str, \"\\n\", \"\\r\\n\");\n    str = string.gsub (str, \"([^%w ])\", function (c) return string.format (\"%%%02X\", string.byte(c)) end);\n    str = string.gsub (str, \" \", \"+\");\n  end\n  return str;\nend\n\ncreateRequestBody = function(action, schema, data)\n  return string.format(\"<u:%s xmlns:u=\\\"%s\\\">%s</u:%s>\", action, schema, data, action);\nend\n\nreponseCallback = function(fnc, args)\n  if (fnc == nil) then\n    return nil;\n  end\n  return fnc(args);\nend\n\ncreateSocket = function()\n    -- Check IP and PORT before\n  if (ip == nil or port == nil) then\n    fibaro:debug(\"You must configure IPAddress and TCPPort first\");\n    return;\n  end\n  local socket;\n  local status, err = pcall(function() \n      socket = Net.FTcpSocket(ip, port);\n      socket:setReadTimeout(1000);\n    end);  \n  if (status ~= nil and status ~= true) then\n    fibaro:debug(\"socket status: \" .. tostring(status or ''));\n  end  \n  if (err ~= nil) then\n    fibaro:debug(\"socket err: \" .. tostring(err or ''));\n    return;\n  end\n  return socket;\nend\n\ndisposeSocket = function(socket)\n  if (socket ~= nil) then\n    socket:disconnect();\n    socket = nil;\n    return true;\n  end\n  return false;\nend\n\nsendSoapMessage = function(url, service, action, args, callback, retry)\n    \n  local socket = createSocket();\n  if (socket == nil) then\n    return;\n  end\n  retry = retry or 0\n  -- prepare data\n  local url = \"POST \" .. url .. \" HTTP/1.1\";\n  fibaro:debug(ip)\n  local so1=\"HOST: \".. ip ..\":1400\"\n  local soapaction = \"SOAPACTION: \\\"\" .. service .. \"#\" .. action.name .. \"\\\"\";\n  local body = createRequestBody(action.name, action.service, tostring(args or \"\"));\n  local envelope = \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?><s:Envelope xmlns:s=\\\"http://schemas.xmlsoap.org/soap/envelope/\\\" s:encodingStyle=\\\"http://schemas.xmlsoap.org/soap/encoding/\\\"><s:Body>\" .. body .. \"</s:Body></s:Envelope>\";\n  local ctl = \"Content-Length: \" .. string.len(envelope);\n  local payload = url .. \"\\r\\n\" .. so1 .. \"\\r\\n\" .. ctl .. \"\\r\\n\" .. soapaction .. \"\\r\\n\" .. \"\\r\\n\" .. envelope;\n  -- write data\n  local bytes, errorcode = socket:write(payload);\n  if (errorcode == 0) then\n    local state, errorcode = socket:read();\n    if (errorcode == 0) then\n      if (string.len(state or \"\") > 0) then\n        -- callback\n        if (callback ~= nil) then\n          reponseCallback(callback, state);\n        end\n        -- dispose ...\n        disposeSocket(socket);\n        return true;\n      else\n        fibaro:debug(\"Error: Invalid response. response length: \" .. string.len(state or \"\"));\n      end\n    else      \n      if (retry < 5) then\n        fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n        return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n      else\n        fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n      end\n    end\n  elseif (errorcode == 2) then\n    fibaro:debug(\"Error: You must check your IP and PORT settings.\");\n  else\n    if (retry < 5) then\n      fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n      return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n    else\n      fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n    end\n  end  \n  -- dispose ...\n  disposeSocket(socket);\n  -- default response\n  return false;\nend\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);\n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n--- Radio Station ---\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nplayRadio= function(station, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-rincon-mp3radio://http://jamfm.hoerradar.de/jamfm-blacklabel-mp3-192?</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n    setVolume(volume);\n    ttsVolumeIsDifferent = true; \n  end\n \n  play();\n \n  end);\nend\n\n-- Globale Variabel abfragen & verwenden\nif fibaro:getGlobalValue(\"Sonos_Radio\") == \"\" then\n  playRadio(\"jamfm.hoerradar.de/jamfm-blacklabel-mp3-192?\", nil);\nelse\n  playRadio(fibaro:getGlobalValue(\"Sonos_Radio\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Radio läuft...\"); --Status Anzeige im VD Interface\n--fibaro:call(selfId, \"setProperty\", \"ui.btnVolume.value\", lastVolume); --Volume Anzeige im VD Interface  \n--fibaro:call(selfId, \"setSlider\", \"ui.btnVolume.value\", lastVolume)","buttonIcon":0,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":14,"lua":true,"waitForResponse":false,"caption":"Good Morning","name":"btnmorning","empty":false,"msg":"-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n-- SONOS Text To Speech (TTS) - Give voice to your HC2 with SONOS wireless speakers\n-- Version 0.0.4 pre-release\n-- Copyright (C) 2014 Jean-Christophe Vermandé\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nselfId = fibaro:getSelfId();    \nip = fibaro:get(selfId, 'IPAddress');\nport = fibaro:get(selfId, 'TCPPort');\ncurrentTransportState = \"\";\nlastTransportState = \"\";\ncurrentVolume = 0;\nlastVolume = 0;\nttsVolumeIsDifferent = false;\n\nurlencode = function(str)\n  if (str) then\n    str = string.gsub (str, \"\\n\", \"\\r\\n\");\n    str = string.gsub (str, \"([^%w ])\", function (c) return string.format (\"%%%02X\", string.byte(c)) end);\n    str = string.gsub (str, \" \", \"+\");\n  end\n  return str;\nend\n\ncreateRequestBody = function(action, schema, data)\n  return string.format(\"<u:%s xmlns:u=\\\"%s\\\">%s</u:%s>\", action, schema, data, action);\nend\n\nreponseCallback = function(fnc, args)\n  if (fnc == nil) then\n    return nil;\n  end\n  return fnc(args);\nend\n\ncreateSocket = function()\n    -- Check IP and PORT before\n  if (ip == nil or port == nil) then\n    fibaro:debug(\"You must configure IPAddress and TCPPort first\");\n    return;\n  end\n  local socket;\n  local status, err = pcall(function() \n      socket = Net.FTcpSocket(ip, port);\n      socket:setReadTimeout(1000);\n    end);  \n  if (status ~= nil and status ~= true) then\n    fibaro:debug(\"socket status: \" .. tostring(status or ''));\n  end  \n  if (err ~= nil) then\n    fibaro:debug(\"socket err: \" .. tostring(err or ''));\n    return;\n  end\n  return socket;\nend\n\ndisposeSocket = function(socket)\n  if (socket ~= nil) then\n    socket:disconnect();\n    socket = nil;\n    return true;\n  end\n  return false;\nend\n\nsendSoapMessage = function(url, service, action, args, callback, retry)\n    \n  local socket = createSocket();\n  if (socket == nil) then\n    return;\n  end\n  retry = retry or 0\n  -- prepare data\n  local url = \"POST \" .. url .. \" HTTP/1.1\";\n  fibaro:debug(ip)\n  local so1=\"HOST: \".. ip ..\":1400\"\n  local soapaction = \"SOAPACTION: \\\"\" .. service .. \"#\" .. action.name .. \"\\\"\";\n  local body = createRequestBody(action.name, action.service, tostring(args or \"\"));\n  local envelope = \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?><s:Envelope xmlns:s=\\\"http://schemas.xmlsoap.org/soap/envelope/\\\" s:encodingStyle=\\\"http://schemas.xmlsoap.org/soap/encoding/\\\"><s:Body>\" .. body .. \"</s:Body></s:Envelope>\";\n  local ctl = \"Content-Length: \" .. string.len(envelope);\n  local payload = url .. \"\\r\\n\" .. so1 .. \"\\r\\n\" .. ctl .. \"\\r\\n\" .. soapaction .. \"\\r\\n\" .. \"\\r\\n\" .. envelope;\n  -- write data\n  local bytes, errorcode = socket:write(payload);\n  if (errorcode == 0) then\n    local state, errorcode = socket:read();\n    if (errorcode == 0) then\n      if (string.len(state or \"\") > 0) then\n        -- callback\n        if (callback ~= nil) then\n          reponseCallback(callback, state);\n        end\n        -- dispose ...\n        disposeSocket(socket);\n        return true;\n      else\n        fibaro:debug(\"Error: Invalid response. response length: \" .. string.len(state or \"\"));\n      end\n    else      \n      if (retry < 5) then\n        fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n        return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n      else\n        fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n      end\n    end\n  elseif (errorcode == 2) then\n    fibaro:debug(\"Error: You must check your IP and PORT settings.\");\n  else\n    if (retry < 5) then\n      fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n      return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n    else\n      fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n    end\n  end  \n  -- dispose ...\n  disposeSocket(socket);\n  -- default response\n  return false;\nend\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);    \n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n-- SONOS Radio\n-- Version 0.0.1 pre-release\n-- Copyright (C) 2015 Nicolas Dörig\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\nlocal currentDate = os.date(\"*t\");\n\n-- Sunday --\nif (currentDate.wday == 1) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/MinnieRiperton-LovinYou.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/MinnieRiperton-LovinYou.mp3\", nil);\n  fibaro:debug(\"Sunday Morning\");\n  \n-- Monday --\nelseif (currentDate.wday == 2) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/ToriAmos-IdontLikeMondays.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/ToriAmos-IdontLikeMondays.mp3\", nil);\n  fibaro:debug(\"Monday Morning\");\n\n-- Tuesday --\nelseif (currentDate.wday == 3) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/SuperFurryAnimals-HelloSunshine.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/SuperFurryAnimals-HelloSunshine.mp3\", nil); \n  fibaro:debug(\"Tuesday Morning\");\n\n-- Wednesday --\nelseif (currentDate.wday == 4) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/EmilianaTorrini-BigJumps.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/EmilianaTorrini-BigJumps.mp3\", nil); \n  fibaro:debug(\"Wednesday Morning\");\n  \n-- Thursday --\nelseif (currentDate.wday == 5) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/TheRascals-ABeauitfulMorning.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/TheRascals-ABeauitfulMorning.mp3\", nil); \n  fibaro:debug(\"Thursday Morning\");\n  \n-- Friday --\nelseif (currentDate.wday == 6) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/Eels-FreshFeeling.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/Eels-FreshFeeling.mp3\", nil); \n  fibaro:debug(\"Friday Morning\");\n  \n-- Saturday --\nelseif (currentDate.wday == 7) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/Eels-SaturdayMorning.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/Eels-SaturdayMorning.mp3\", nil);\n  fibaro:debug(\"Saturday Morning\");\n  \nelse\n  playMusic(fibaro:getGlobalValue(\"Sonos_Music\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Musik läuft...\"); --Status Anzeige im VD Interface\n\n\n-- x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/ToriAmos-Idon'tLikeMondays.mp3","buttonIcon":1007,"favourite":false,"main":false},{"id":15,"lua":true,"waitForResponse":false,"caption":"Good Night","name":"btnnight","empty":false,"msg":"-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n-- SONOS Text To Speech (TTS) - Give voice to your HC2 with SONOS wireless speakers\n-- Version 0.0.4 pre-release\n-- Copyright (C) 2014 Jean-Christophe Vermandé\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n\nselfId = fibaro:getSelfId();    \nip = fibaro:get(selfId, 'IPAddress');\nport = fibaro:get(selfId, 'TCPPort');\ncurrentTransportState = \"\";\nlastTransportState = \"\";\ncurrentVolume = 0;\nlastVolume = 0;\nttsVolumeIsDifferent = false;\n\nurlencode = function(str)\n  if (str) then\n    str = string.gsub (str, \"\\n\", \"\\r\\n\");\n    str = string.gsub (str, \"([^%w ])\", function (c) return string.format (\"%%%02X\", string.byte(c)) end);\n    str = string.gsub (str, \" \", \"+\");\n  end\n  return str;\nend\n\ncreateRequestBody = function(action, schema, data)\n  return string.format(\"<u:%s xmlns:u=\\\"%s\\\">%s</u:%s>\", action, schema, data, action);\nend\n\nreponseCallback = function(fnc, args)\n  if (fnc == nil) then\n    return nil;\n  end\n  return fnc(args);\nend\n\ncreateSocket = function()\n    -- Check IP and PORT before\n  if (ip == nil or port == nil) then\n    fibaro:debug(\"You must configure IPAddress and TCPPort first\");\n    return;\n  end\n  local socket;\n  local status, err = pcall(function() \n      socket = Net.FTcpSocket(ip, port);\n      socket:setReadTimeout(1000);\n    end);  \n  if (status ~= nil and status ~= true) then\n    fibaro:debug(\"socket status: \" .. tostring(status or ''));\n  end  \n  if (err ~= nil) then\n    fibaro:debug(\"socket err: \" .. tostring(err or ''));\n    return;\n  end\n  return socket;\nend\n\ndisposeSocket = function(socket)\n  if (socket ~= nil) then\n    socket:disconnect();\n    socket = nil;\n    return true;\n  end\n  return false;\nend\n\nsendSoapMessage = function(url, service, action, args, callback, retry)\n    \n  local socket = createSocket();\n  if (socket == nil) then\n    return;\n  end\n  retry = retry or 0\n  -- prepare data\n  local url = \"POST \" .. url .. \" HTTP/1.1\";\n  fibaro:debug(ip)\n  local so1=\"HOST: \".. ip ..\":1400\"\n  local soapaction = \"SOAPACTION: \\\"\" .. service .. \"#\" .. action.name .. \"\\\"\";\n  local body = createRequestBody(action.name, action.service, tostring(args or \"\"));\n  local envelope = \"<?xml version=\\\"1.0\\\" encoding=\\\"utf-8\\\"?><s:Envelope xmlns:s=\\\"http://schemas.xmlsoap.org/soap/envelope/\\\" s:encodingStyle=\\\"http://schemas.xmlsoap.org/soap/encoding/\\\"><s:Body>\" .. body .. \"</s:Body></s:Envelope>\";\n  local ctl = \"Content-Length: \" .. string.len(envelope);\n  local payload = url .. \"\\r\\n\" .. so1 .. \"\\r\\n\" .. ctl .. \"\\r\\n\" .. soapaction .. \"\\r\\n\" .. \"\\r\\n\" .. envelope;\n  -- write data\n  local bytes, errorcode = socket:write(payload);\n  if (errorcode == 0) then\n    local state, errorcode = socket:read();\n    if (errorcode == 0) then\n      if (string.len(state or \"\") > 0) then\n        -- callback\n        if (callback ~= nil) then\n          reponseCallback(callback, state);\n        end\n        -- dispose ...\n        disposeSocket(socket);\n        return true;\n      else\n        fibaro:debug(\"Error: Invalid response. response length: \" .. string.len(state or \"\"));\n      end\n    else      \n      if (retry < 5) then\n        fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n        return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n      else\n        fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n      end\n    end\n  elseif (errorcode == 2) then\n    fibaro:debug(\"Error: You must check your IP and PORT settings.\");\n  else\n    if (retry < 5) then\n      fibaro:debug(\"retry #\"..retry..\" action: \" .. action.name);\n      return sendSoapMessage(url, service, action, args, callback, (retry + 1));\n    else\n      fibaro:debug(\"Error: Code returned \"..tostring(errorcode or \"\"));\n    end\n  end  \n  -- dispose ...\n  disposeSocket(socket);\n  -- default response\n  return false;\nend\n\nstop = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Stop\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"stop sent\");\n    end);    \nend\n\nunMute = function()\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetMute\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredMute>0</DesiredMute>\",\n      -- callback (options)\n    function(response)\n      fibaro:debug(\"unMute sent\");\n    end); \nend\n\nplay = function(duration)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"Play\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Speed>1</Speed>\",\n      -- callback (options)\n    function(response)   \n      fibaro:debug(\"Play\");\n    end);    \nend\n\nsetVolume = function(value)\n  return sendSoapMessage(\n    -- control url\n    \"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:RenderingControl:1\",\n    -- action\n    { name = \"SetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID><Channel>Master</Channel><DesiredVolume>\" .. tostring(value) .. \"</DesiredVolume>\",\n    -- callback (options)\n    function(response)      \n      fibaro:debug(\"Volume set: \" .. value);\n    end);\nend\n\ngetVolume = function()\n  fibaro:log(\"Get volume, please wait...\");\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/RenderingControl/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetVolume\", service = \"urn:schemas-upnp-org:service:RenderingControl:1\" },\n    -- soap body data (options)    \n    \"<InstanceID>0</InstanceID><Channel>Master</Channel>\",\n    -- callback (options)\n    function(response)\n      currentVolume = tonumber(response:match(\"<CurrentVolume>(.+)</CurrentVolume>\") or 0);    \n    end);\nend\n\ngetTransportState = function()\n  return sendSoapMessage(\n    -- control url\n  \t\"/MediaRenderer/AVTransport/Control\",\n    -- service type\n    \"urn:schemas-upnp-org:service:AVTransport:1\",\n    -- action\n    { name = \"GetTransportInfo\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n    -- soap body data (options)\n    \"<InstanceID>0</InstanceID>\",\n    -- callback (options)\n    function(response)      \n      currentTransportState = response:match(\"<CurrentTransportState>(.+)</CurrentTransportState>\") or \"\";\n    end);\nend\n\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\n-- SONOS Radio\n-- Version 0.0.1 pre-release\n-- Copyright (C) 2015 Nicolas Dörig\n-------------------------------------------------------------------------------------------\n-------------------------------------------------------------------------------------------\nlocal currentDate = os.date(\"*t\");\n\nif (currentDate.wday == 4) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/EdSheeran-PartingGlass.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/EdSheeran-PartingGlass.mp3\", nil);\n  fibaro:debug(\"Good Night\");\n\n-------------------------------------------------------------------------------------------\n\nelseif (currentDate.wday ~= 4) then\n  \nplayMusic= function(music, volume)\n  return sendSoapMessage(\n  -- control url\n  \"/MediaRenderer/AVTransport/Control\",\n  -- service type\n  \"urn:schemas-upnp-org:service:AVTransport:1\",\n  -- action\n  { name = \"SetAVTransportURI\", service = \"urn:schemas-upnp-org:service:AVTransport:1\" },\n  -- soap body data (options)\n  \"<InstanceID>0</InstanceID>,<CurrentURI>x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/SalmaHayek-QuedateAqui.mp3</CurrentURI>,<CurrentURIMetaData></CurrentURIMetaData>\",\n  -- callback (options)\n  function(response)\n  -- retrieve current transport state\n  getTransportState();\n  lastTransportState = currentTransportState;\n  -- unmute before\n  unMute();\n  -- retrieve volume\n  getVolume();\n  lastVolume = currentVolume;\n  -- set tts volume if <> with current\n  if (volume ~= nil and volume ~= currentVolume) then\n  setVolume(volume);\n  ttsVolumeIsDifferent = true;\n  end\n      \n  play();\n \n  end);\nend\n\n  playMusic(\"//192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/SalmaHayek-QuedateAqui.mp3\", nil); \n  fibaro:debug(\"Good Night\");\n  \nelse\n  playMusic(fibaro:getGlobalValue(\"Sonos_Music\"), nil);\nend\n\nfibaro:call(selfId, \"setProperty\", \"ui.Label1.value\", \"Musik läuft...\"); --Status Anzeige im VD Interface\n\n\n-- x-file-cifs://192.168.2.20/iMusic/Fibaro HomeCenter 2/Music/SalmaHayek-QuedateAqui.mp3\n","buttonIcon":1008,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}