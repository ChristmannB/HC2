{"name":"Chauffage Maison","type":"virtual_device","properties":{"deviceIcon":59,"currentIcon":"60","log":"","logTemp":"","mainLoop":"--[[\n%% properties\n%% globals\nMode_Maison\n--]]\n-- démarrage de la boucle\n--while true do\n\nlocal valueHouseMode = fibaro:getGlobal('Mode_Maison')\nfibaro:debug('Le chauffage est en mode '..valueHouseMode )\n\n-- Afficahge du label1\nfibaro:call(87,'setProperty','ui.Label1.value', valueHouseMode)\n-- Test do Mode\n    if (valueHouseMode=='Automatique')\n    then\n\t\tfibaro:startScene(2)\n\telseif \t(valueHouseMode=='Hors_Gel')\n  \t\tthen fibaro:startScene(5)\n  \t\t\telseif (valueHouseMode=='Presence')\n  \t\tthen fibaro:startScene(6)\n  \t\t\t\telseif (ValueHouseMode=='STOP')\n  \t\t\t\tthen fibaro:abort()\n  \t\t\t\telse fibaro:debug('Switch Error') \n    end    \n\t--end","ui.Label1.value":"Presence","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"---Chauffage---","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Automatique","name":"Button11","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Automatique')","buttonIcon":59,"favourite":false,"main":true}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"Présence","name":"Button21","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Presence')","buttonIcon":60,"favourite":false,"main":false},{"id":4,"lua":true,"waitForResponse":false,"caption":"Hors Gel","name":"Button22","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'Hors_Gel')","buttonIcon":61,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":5,"lua":true,"waitForResponse":false,"caption":"STOP","name":"Button31","empty":false,"msg":"fibaro:setGlobal('Mode_Maison', 'STOP')","buttonIcon":93,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}