{"name":"Gestion Chauffeau M","type":"virtual_device","properties":{"deviceIcon":1001,"categories":"[\"other\"]","currentIcon":"1003","log":"","logTemp":"","mainLoop":"local ModeChauffe = fibaro:getGlobal(\"Chauffeau\")\nlocal Chauffeau_ID = 558\n-- local Node_2ID = nn\n-- local VD_ID = 672 \nlocal VDID = fibaro:getSelfId() -- obtention de l'identité de ce VD\n\tfibaro:debug(\" Le VD Chauffe-eau \" .. VDID .. \" est lancé\")\n\nlocal Etat_Node1\n--local Etat_Node2\nlocal i = 0\nfibaro:debug(\"les Machines sont en mode \".. ModeChauffe)\n-- Affichage du label1 & 2\n-- fibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n-- fibaro:call(VDID,'setProperty','ui.Label2.value', ModeChauffe)\n-- Utilisation de l'heure et de la date\nlocal Maintenant = os.date(\"*t\") --stocke la date et heure actuelle du système sous forme d'un tableau à l'intérieur de la variable \"Maintenant\"\n--  Affichage de la date et l'heure\nfibaro:debug(\"il est maintenant \".. Maintenant['hour']..\"h\"..Maintenant['min']..\"min\"..\", le \"..Maintenant['day']..\"/\"..Maintenant['month']..\"/\"..Maintenant['year'])\nlocal hstart= fibaro:getGlobal(\"Hstart\")\nlocal hend= fibaro:getGlobal(\"Hend\")\nfibaro:debug(\"Début : \"..hstart..\", Fin : \"..hend)\nif (ModeChauffe == 'Stop')\n\t\t\t\t\t\t\t\t\t\t\n  then fibaro:call(Chauffeau_ID,\"turnOff\") -- Ballon MAISON\n  \t   \t\t\t\t\t\t-- Affichage du label1\n\t fibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n  \n    elseif (ModeChauffe == \"Marche\")\n\t\n      then fibaro:call(Chauffeau_ID,\"turnOn\")\n  \t     --fibaro:call(Node_2ID,\"turnOn\")\n\t\t\t\t\t\t\t-- Affichage du label1\n\t-- fibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n     fibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n    \t\t\n\telseif (ModeChauffe == \"HeuresCreuses\") \n    \t\tthen \n\t\t\t\t\t\t\t\t\t\t-- Affichage du label1 et du label2\n \t\t\t\t\t\t\tfibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n\t\t\t\t\t\t\t-- fibaro:call(VDID,'setProperty','ui.Label2.value', ModeChauffe)\n  \t\t\t--if ( Maintenant['hour'] < 8 or Maintenant['hour'] > 22)\n  \t\t\tif ( Maintenant['hour'] <= tonumber(hend) or Maintenant['hour'] >= tonumber(hstart))\n            \tthen fibaro:call(Chauffeau_ID,\"turnOn\")\n    fibaro:debug(\"Début: \"..hstart..\" - \"..Maintenant['hour']..\" - \"..hend)\n    \t\t\t\t \n    \t\t  \t \t --fibaro:call(Node_2ID,\"turnOn\")\n    \t\t\telse fibaro:call(Chauffeau_ID,\"turnOff\")\n    \t\t\t\t  \n      \t\t\t\t --fibaro:call(Node_2ID,\"turnOff\")\n\t\t\t\t\t\t\t\t\t\t-- Affichage du label1\n\t\t\t\t\t\t\t\t\t\t--fibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n                end\nend\n\nif (tonumber(fibaro:getValue(Chauffeau_ID,\"value\")) == 0)\nthen Etat_Node1 = 'Arrêt' --'Off'\nelse Etat_Node1 = 'Marche' --'On'\nend\nfibaro:debug(\"Switch \" .. Chauffeau_ID .. \" is : \" .. Etat_Node1) \n\n--if (tonumber(fibaro:getValue(Chauffeau_ID,\"value\")) == 0) \n--then Etat_Node2 = 'Off'\n--else Etat_Node2 = 'On'\n--end\n--fibaro:debug(\"Switch \" .. Node_2ID .. \" is : \".. Etat_Node2)\n\n  \ni=i+1 -- Compteur d'occurance\n\nfibaro:debug(\"Le chauffeau de la MAISON est en mode \".. Etat_Node1)  \n--fibaro:debug(\"La machine \" .. Node_2ID ..  \" est en mode \"..fibaro:getValue(Node_2ID,\"value\"))\n--fibaro:debug(\"L'état de machine \" .. Node_2ID ..  \"est : \".. Etat_Node2)\nfibaro:debug(\"le BALLON ESt en mode \".. ModeChauffe)\n\t\t\t-- Affichage du label1 & label2\nfibaro:sleep(1500)\n\t\t\tfibaro:call(VDID,'setProperty','ui.Label1.value', ModeChauffe)\n--\t\t\tfibaro:call(VDID,'setProperty','ui.Label2.value', ModeChauffe)\n\t\t\tfibaro:debug(\"le label1 est à \"..fibaro:getValue(VDID,\"ui.Label1.value\"))\n--\t\t\tfibaro:debug(\"le label2 est à \"..fibaro:getValue(VDID,\"ui.Label2.value\"))\nfibaro:sleep(180000) -- tempo optimale 180000\nif i>1\nthen fibaro:abort()\nend","ui.Horaire.value":"23h00   -   Fin à : 7h00","ui.Label1.value":"HeuresCreuses","visible":"true","rows":[{"type":"label","elements":[{"id":1,"lua":false,"waitForResponse":false,"caption":"Mode Chauffeau","name":"Label1","favourite":false,"main":true}]},{"type":"button","elements":[{"id":2,"lua":true,"waitForResponse":false,"caption":"Arrêt","name":"Button11","empty":false,"msg":"fibaro:setGlobal('Chauffeau',\"Stop\")\nfibaro:log(\"Chauffe-eau mis à l'arrêt\")","buttonIcon":1002,"favourite":false,"main":false}]},{"type":"button","elements":[{"id":3,"lua":true,"waitForResponse":false,"caption":"H Creuses","name":"Button21","empty":false,"msg":"fibaro:setGlobal('Chauffeau',\"HeuresCreuses\")\nfibaro:log(\"Fonctionnement aux heures creuses\")\n","buttonIcon":1003,"favourite":false,"main":false},{"id":4,"lua":true,"waitForResponse":false,"caption":"Marche forcée","name":"Button22","empty":false,"msg":"fibaro:setGlobal('Chauffeau',\"Marche\")\nfibaro:log(\"Chauffe-eau en marche permanente\")","buttonIcon":1004,"favourite":false,"main":false}]},{"type":"label","elements":[{"id":5,"lua":false,"waitForResponse":false,"caption":"Horaire Début","name":"Horaire","favourite":false,"main":false}]},{"type":"button","elements":[{"id":6,"lua":true,"waitForResponse":false,"caption":"S+1h","name":"Button31","empty":false,"msg":"fibaro:debug(\"Start -1H\")\nhStart =fibaro:getGlobal(\"Hstart\")+1\n  if hStart >23 then hStart=23 end\n  fibaro:debug(hStart)\n  fibaro:setGlobal(\"Hstart\", hStart)\nfibaro:call(658,'setProperty','ui.Horaire.value', hStart..\"h00   -   Fin à : \".. fibaro:getGlobal(\"Hend\")..\"h00\")   ","buttonIcon":1003,"favourite":false,"main":false},{"id":7,"lua":true,"waitForResponse":false,"caption":"S-1h","name":"Button32","empty":false,"msg":"fibaro:debug(\"Start -1H\")\nhStart =fibaro:getGlobal(\"Hstart\")-1\n  if hStart <12 then hStart=12 end\n  fibaro:debug(hStart)\n  fibaro:setGlobal(\"Hstart\", hStart)\nfibaro:call(658,'setProperty','ui.Horaire.value', hStart..\"h00   -   Fin à : \".. fibaro:getGlobal(\"Hend\")..\"h00\")   ","buttonIcon":1003,"favourite":false,"main":false},{"id":8,"lua":true,"waitForResponse":false,"caption":"F+1h","name":"Button33","empty":false,"msg":"fibaro:debug(\"End +1H\")\nhEnd =fibaro:getGlobal(\"Hend\")+1\n  if hEnd >9 then hEnd=9 end\n  fibaro:debug(hEnd)\n  fibaro:setGlobal(\"Hend\", hEnd)\nfibaro:call(658,'setProperty','ui.Horaire.value', fibaro:getGlobal(\"Hstart\")..\"h00   -   Fin à : \".. fibaro:getGlobal(\"Hend\")..\"h00\")   ","buttonIcon":1003,"favourite":false,"main":false},{"id":9,"lua":true,"waitForResponse":false,"caption":"F-1h","name":"Button34","empty":false,"msg":"fibaro:debug(\"1; Fin -1h\")\nhEnd =fibaro:getGlobal(\"Hend\")-1\n  if hEnd <1 then hEnd=1 end\n  fibaro:debug(\"2; \"..hEnd)\n  fibaro:setGlobal(\"Hend\", hEnd)\nfibaro:call(658,'setProperty','ui.Horaire.value', fibaro:getGlobal(\"Hstart\")..\"h00   -   Fin à : \".. fibaro:getGlobal(\"Hend\")..\"h00\")   \n","buttonIcon":1003,"favourite":false,"main":false}]}]},"actions":{"pressButton":1,"setSlider":2,"setProperty":2}}